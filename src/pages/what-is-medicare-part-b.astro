---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS, MEDICARE_2026 } from '../data/site';

const title = 'What Is Medicare Part B? (Medical Insurance)';
const description = 'Medicare Part B is medical insurance — it covers doctor visits, outpatient care, and preventive services. Here’s what it covers, the 2026 costs, and what it leaves to you.';
const today = '2026-06-03';

const faqs = [
  { q: 'What does Medicare Part B cover?', a: 'Part B covers doctor visits, outpatient care, preventive services, lab tests, mental health care, and durable medical equipment. It’s the medical side of Original Medicare, alongside Part A’s hospital coverage.' },
  { q: 'How much does Medicare Part B cost in 2026?', a: `Part B has a standard monthly premium set by Medicare each year, plus an annual deductible of ${MEDICARE_2026.partBDeductible} in ${MEDICARE_2026.year}. After the deductible, you generally pay 20% of the Medicare-approved amount, with no annual out-of-pocket cap on its own.` },
  { q: 'Is the Part B deductible covered by Medigap?', a: `Most Medigap plans available to newer enrollees, including Plan G, do not cover the Part B deductible (${MEDICARE_2026.partBDeductible} in ${MEDICARE_2026.year}) — you pay that yourself. After it’s met, a plan like Plan G covers most of the remaining Part B coinsurance.` },
  { q: 'Do I have to enroll in Part B at 65?', a: 'Not always. If you have qualifying coverage through current employment, you may delay Part B without penalty. Otherwise, enrolling during your Initial Enrollment Period avoids a lifelong late-enrollment penalty.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/what-is-medicare-part-b` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/what-is-medicare-part-b#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="What Is Medicare Part B?"
    subtitle="The medical side of Original Medicare — doctor visits, outpatient care, and preventive services. Here’s what it covers and what it costs."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Medicare Basics', href: '/medicare-basics' }, { label: 'Part B' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Questions about Part B?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          <strong>Medicare Part B is medical insurance.</strong> It covers doctor visits, outpatient care, preventive services, lab
          work, and durable medical equipment. Part B has a standard monthly premium and an annual deductible
          ({MEDICARE_2026.partBDeductible} in {MEDICARE_2026.year}); after that, you generally pay 20% of the Medicare-approved
          amount, with no annual cap on its own.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Part B is the everyday side of Medicare — the doctor visits and outpatient care. It’s also where that open-ended 20%
        coinsurance makes extra coverage worth considering.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>What Part B covers</h2>
      <p>
        Part B pays for doctor and specialist visits, outpatient hospital care, preventive screenings, lab tests, mental health
        services, and durable medical equipment like walkers and wheelchairs. It pairs with <a href="/what-is-medicare-part-a">Part
        A</a> to form Original Medicare.
      </p>

      <h2>What Part B costs in {MEDICARE_2026.year}</h2>
      <p>
        Part B has a standard monthly premium set by Medicare each year (higher earners pay more), plus an annual deductible of
        {MEDICARE_2026.partBDeductible}. After the deductible, you typically pay 20% of the Medicare-approved amount for covered
        services — and there’s no yearly limit on that 20% by itself, which is the main reason people add a
        <a href="/services/medicare-supplement">Medigap</a> plan or choose <a href="/services/medicare-advantage">Medicare
        Advantage</a>.
      </p>

      <h2>How Medigap works with Part B</h2>
      <p>
        Most Medigap plans available to newer enrollees, including <a href="/medicare-plan-g">Plan G</a>, leave you the Part B
        deductible but then cover the bulk of the remaining 20% coinsurance — turning an open-ended cost into something predictable.
      </p>

      <h2>When to enroll in Part B</h2>
      <p>
        If you have qualifying employer coverage, you may delay Part B without penalty; otherwise, enroll during your
        <a href="/medicare-initial-enrollment-period">Initial Enrollment Period</a> to avoid a lifelong late penalty.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want help making Part B costs predictable?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Related: <a href="/medicare-basics">Medicare basics</a> and <a href="/what-is-medicare-part-a">what is Part A</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          {MEDICARE_2026.year} figures are set by Medicare and change annually; the standard premium varies by income. This page is
          educational and not individualized advice. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/basics/get-started-with-medicare/medicare-basics/parts-of-medicare" rel="nofollow noopener" target="_blank">Medicare.gov — Parts of Medicare</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Let’s make your Part B costs predictable" />
</BaseLayout>
