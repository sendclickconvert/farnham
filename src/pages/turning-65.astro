---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS } from '../data/site';

const title = 'Turning 65 and Medicare: What to Do (2026)';
const description = 'Turning 65? Here’s a plain-language walkthrough of your Medicare decisions — when to enroll, how to avoid penalties, and how to choose the right coverage.';
const today = '2026-06-03';

const faqs = [
  { q: 'When should I sign up for Medicare when turning 65?', a: 'Your Initial Enrollment Period is a 7-month window: the three months before the month you turn 65, your birthday month, and the three months after. Signing up early in that window helps your coverage start on time and avoids gaps.' },
  { q: 'Do I have to enroll in Medicare at 65?', a: 'Not always. If you have qualifying coverage through current employment, you may be able to delay Part B without penalty. But if you don’t have that, signing up during your Initial Enrollment Period avoids late penalties that can last a lifetime.' },
  { q: 'What decisions do I make when I turn 65?', a: 'After enrolling in Original Medicare (Parts A and B), you choose how to round it out: either a Medicare Supplement (Medigap) plan plus a Part D drug plan, or a Medicare Advantage plan. Each path has trade-offs worth understanding before you decide.' },
  { q: 'What happens if I miss my Medicare enrollment window?', a: 'Missing your Initial Enrollment Period can mean waiting for a later window and paying lifelong late-enrollment penalties on Part B and Part D. That’s why it’s worth planning a few months ahead.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: 'Turning 65 and Medicare: What to Do', description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/turning-65` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/turning-65#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Turning 65 and Medicare"
    subtitle="The decisions, the deadlines, and the path that fits you — explained simply, without the jargon. This is exactly what Jim teaches in his no-cost Medicare 101 classes."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Turning 65' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Turning 65 soon? Let’s map out your steps.</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          Turning 65 starts your <strong>Initial Enrollment Period</strong> — a 7-month window around your birthday to sign up for
          Medicare. Once you have Original Medicare (Parts A and B), you choose how to round it out: a
          <strong>Medigap plan plus Part D</strong>, or a <strong>Medicare Advantage plan</strong>. Enrolling on time avoids
          penalties that can last for life.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Turning 65 comes with a short list of important decisions and a few firm deadlines. Get those right and the rest gets much
        easier.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>When to enroll in Medicare</h2>
      <p>
        Your Initial Enrollment Period spans seven months: the three months before your birthday month, the month you turn 65, and
        the three months after. Enrolling in the first part of that window helps coverage begin without a gap. If you’re still
        working with qualifying employer coverage, you may be able to delay Part B without penalty — but it’s worth confirming. See
        the details in the <a href="/medicare-initial-enrollment-period">Medicare Initial Enrollment Period</a> guide.
      </p>

      <h2>Step one: Original Medicare (Parts A and B)</h2>
      <p>
        Medicare starts with Part A (hospital) and Part B (medical). Most people pay no premium for Part A, and Part B has a standard
        monthly premium. Together they cover a lot — but they leave deductibles and coinsurance with no annual limit, which is why
        most people add more coverage. Learn the building blocks in <a href="/medicare-basics">Medicare basics</a>.
      </p>

      <h2>Step two: choose how to round it out</h2>
      <p>
        From here you take one of two paths. You can pair Original Medicare with a
        <a href="/services/medicare-supplement">Medicare Supplement (Medigap)</a> plan and a separate
        <a href="/services/prescription-drug-plans">Part D</a> drug plan, or you can choose a
        <a href="/services/medicare-advantage">Medicare Advantage</a> plan that bundles coverage. Our guide to
        <a href="/medicare-advantage-vs-medigap">Medicare Advantage vs. Medigap</a> lays out both fairly.
      </p>

      <h2>Avoiding late-enrollment penalties</h2>
      <p>
        Both Part B and Part D carry late-enrollment penalties that can be added to your premium for as long as you have coverage if
        you sign up late without qualifying coverage. Planning a few months ahead is the simplest way to avoid them — see the
        <a href="/medicare-part-d-late-enrollment-penalty">Part D late-enrollment penalty</a> guide.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want a clear plan for turning 65?</p>
        <p class="text-white/70 text-sm mb-4 m-0">A no-cost, no-pressure walkthrough — or join a no-cost Medicare 101 class.</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Next steps: the <a href="/medicare-initial-enrollment-period">Initial Enrollment Period</a> and your
        <a href="/medicare-checklist-turning-65">pre-65 checklist</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Enrollment rules and penalties reflect federal law as of 2026 and may change; your situation may qualify for exceptions.
          This page is educational and not individualized advice. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/basics/get-started-with-medicare/sign-up" rel="nofollow noopener" target="_blank">Medicare.gov — Sign up for Medicare</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Turning 65? Let’s build your Medicare plan together." />
</BaseLayout>
