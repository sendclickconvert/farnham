---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS } from '../data/site';

const title = 'What Is Medicare Part A? (Hospital Insurance)';
const description = 'Medicare Part A is hospital insurance — it covers inpatient stays, skilled nursing, hospice, and some home health. Here’s what it covers, what it costs, and what it leaves to you.';
const today = '2026-06-03';

const faqs = [
  { q: 'What does Medicare Part A cover?', a: 'Part A covers inpatient hospital care, skilled nursing facility care (after a qualifying hospital stay), hospice care, and some home health care. It’s the hospital side of Original Medicare.' },
  { q: 'How much does Medicare Part A cost?', a: 'Most people pay no monthly premium for Part A because they or a spouse paid Medicare taxes for enough quarters while working. Part A does have a deductible for each benefit period, plus coinsurance for longer stays.' },
  { q: 'Is Medicare Part A free?', a: 'It’s premium-free for most people, but “free” isn’t quite right — there’s a deductible per benefit period and daily coinsurance for extended hospital or skilled nursing stays. A Medigap plan can cover much of that cost-sharing.' },
  { q: 'Do I need to sign up for Part A?', a: 'If you’re already getting Social Security, you’re usually enrolled automatically at 65. Otherwise you sign up during your Initial Enrollment Period. Because it’s typically premium-free, most people take Part A when first eligible.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/what-is-medicare-part-a` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/what-is-medicare-part-a#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="What Is Medicare Part A?"
    subtitle="The hospital side of Original Medicare — what it covers, why it’s usually premium-free, and what it still leaves you to pay."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Medicare Basics', href: '/medicare-basics' }, { label: 'Part A' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Questions about Part A?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          <strong>Medicare Part A is hospital insurance.</strong> It covers inpatient hospital stays, skilled nursing facility care,
          hospice, and some home health care. Most people pay <strong>no monthly premium</strong> for Part A, though it has a
          deductible per benefit period and coinsurance for longer stays.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Part A is the part of Medicare most people already have an instinct for — it’s the hospital coverage. Here’s the detail.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>What Part A covers</h2>
      <p>
        Part A pays for inpatient hospital care, care in a skilled nursing facility after a qualifying hospital stay, hospice care,
        and some home health services. It’s focused on facility-based care rather than everyday doctor visits, which fall under
        <a href="/what-is-medicare-part-b">Part B</a>.
      </p>

      <h2>What Part A costs</h2>
      <p>
        Most people pay no premium for Part A, having earned it through years of Medicare taxes. But it isn’t cost-free: there’s a
        deductible for each benefit period and daily coinsurance once a stay runs long. A <a href="/services/medicare-supplement">Medigap</a>
        plan is designed to cover much of that cost-sharing.
      </p>

      <h2>Signing up for Part A</h2>
      <p>
        If you already receive Social Security, you’re typically enrolled automatically at 65. Otherwise, you enroll during your
        <a href="/medicare-initial-enrollment-period">Initial Enrollment Period</a>. Because it’s usually premium-free, most people
        take Part A as soon as they’re eligible.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want the full Medicare picture?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Related: <a href="/medicare-basics">Medicare basics</a> and <a href="/what-is-medicare-part-b">what is Part B</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Coverage and cost details reflect federal rules as of 2026 and may change. This page is educational and not individualized
          advice. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/basics/get-started-with-medicare/medicare-basics/parts-of-medicare" rel="nofollow noopener" target="_blank">Medicare.gov — Parts of Medicare</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Let’s walk through how Part A fits your plan" />
</BaseLayout>
