---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS } from '../data/site';

const title = 'Medicare Initial Enrollment Period Explained';
const description = 'Your Medicare Initial Enrollment Period is a 7-month window around your 65th birthday. Here’s exactly when it starts, what to do, and how to avoid late penalties.';
const today = '2026-06-03';

const faqs = [
  { q: 'When is my Medicare Initial Enrollment Period?', a: 'It is a 7-month window: the three months before the month you turn 65, the month of your 65th birthday, and the three months after. For most people this is their first chance to enroll in Medicare.' },
  { q: 'When does my Medicare coverage start?', a: 'If you enroll in the three months before your birthday month, coverage generally starts the first day of your birthday month. If you enroll during or after your birthday month, coverage typically starts the month after you sign up.' },
  { q: 'What if I am still working at 65?', a: 'If you have qualifying coverage through current employment, you may be able to delay Part B without a penalty and enroll later through a Special Enrollment Period. The rules depend on your employer’s size and your specific coverage, so it’s worth confirming.' },
  { q: 'What is the penalty for enrolling in Part B late?', a: 'If you don’t enroll when first eligible and don’t have qualifying coverage, the Part B premium can be increased by 10% for each full 12-month period you could have had it — and that increase generally lasts as long as you have Part B.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/medicare-initial-enrollment-period` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/medicare-initial-enrollment-period#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Medicare Initial Enrollment Period"
    subtitle="The 7-month window that opens around your 65th birthday — when to act, when coverage starts, and how to avoid lifelong penalties."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Turning 65', href: '/turning-65' }, { label: 'Initial Enrollment Period' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Want help with your enrollment timing?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          Your <strong>Medicare Initial Enrollment Period</strong> is a 7-month window: the <strong>three months before</strong> the
          month you turn 65, your <strong>birthday month</strong>, and the <strong>three months after</strong>. Enrolling in the
          first three months helps your coverage start on time. Missing the window can mean lifelong late penalties.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        This is the most important deadline in Medicare for most people. The window itself is simple once you see it laid out.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>The 7-month window, laid out</h2>
      <p>
        Picture seven months centered on your birthday month: three months before, the birthday month itself, and three months
        after. You can enroll in Medicare any time during that span. The part you choose affects when coverage begins.
      </p>

      <h2>When your coverage starts</h2>
      <p>
        Enroll in the three months before your birthday month and coverage generally begins the first day of your birthday month.
        Enroll during or after your birthday month and coverage usually starts the month after you sign up. Enrolling early is the
        cleanest way to avoid a coverage gap.
      </p>

      <h2>If you’re still working</h2>
      <p>
        If you have qualifying coverage through current employment, you may be able to delay Part B without penalty and use a Special
        Enrollment Period later. Whether that applies depends on your employer’s size and your coverage, so confirm your situation
        before you delay.
      </p>

      <h2>Avoiding the Part B late penalty</h2>
      <p>
        If you skip Part B when first eligible without qualifying coverage, the premium can rise 10% for each full year you could
        have had it — and that increase generally lasts as long as you have Part B. Planning ahead avoids it. The same idea applies
        to drug coverage; see the <a href="/medicare-part-d-late-enrollment-penalty">Part D late-enrollment penalty</a>.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want to get the timing exactly right?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Related: <a href="/turning-65">Turning 65 and Medicare</a> and the
        <a href="/medicare-checklist-turning-65">pre-65 checklist</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Enrollment timing and penalty rules reflect federal law as of 2026 and may change; exceptions may apply to your situation.
          This page is educational and not individualized advice. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/basics/get-started-with-medicare/sign-up/when-does-medicare-coverage-start" rel="nofollow noopener" target="_blank">Medicare.gov — When coverage starts</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Let’s nail down your enrollment timing" />
</BaseLayout>
