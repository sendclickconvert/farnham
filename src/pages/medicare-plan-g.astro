---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS, MEDICARE_2026 } from '../data/site';

const title = 'Medicare Plan G Explained (2026)';
const description = 'Medicare Plan G is the Medigap plan that covers nearly all of Original Medicare’s gaps except the Part B deductible. See what it covers and who it fits in 2026.';
const today = '2026-06-03';

const faqs = [
  { q: 'What does Medicare Plan G cover?', a: `Plan G covers Part A hospital coinsurance and deductible, Part B coinsurance, skilled nursing facility coinsurance, the first three pints of blood, hospice coinsurance, Part B excess charges, and foreign travel emergencies (up to plan limits). It covers everything Medigap can except the Part B deductible (${MEDICARE_2026.partBDeductible} in ${MEDICARE_2026.year}).` },
  { q: 'What does Plan G not cover?', a: `The one gap Plan G leaves is the annual Part B deductible (${MEDICARE_2026.partBDeductible} in ${MEDICARE_2026.year}), which you pay yourself. It also does not include prescription drug coverage, dental, vision, or hearing — those are separate.` },
  { q: 'Is Plan G the same from every insurer?', a: 'Yes. Medigap benefits are standardized by law, so a Plan G covers the same things no matter which company issues it. The differences between insurers come down to price, rate history, and service — not coverage.' },
  { q: 'Is there a lower-cost version of Plan G?', a: 'Yes. High-Deductible Plan G offers the same coverage for a much lower premium, in exchange for a higher annual deductible before the plan pays. It can be a good fit for people who are generally healthy and want to lower monthly costs.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: 'Medicare Plan G Explained (2026)', description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/medicare-plan-g` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/medicare-plan-g#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Medicare Plan G Explained"
    subtitle="The Medigap plan that covers nearly every gap Original Medicare leaves — with the freedom to see any doctor that accepts Medicare."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Medicare Supplement', href: '/services/medicare-supplement' }, { label: 'Plan G' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Want to see Plan G options for you?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          <strong>Medicare Plan G</strong> is the Medigap plan that covers nearly all of Original Medicare’s out-of-pocket gaps —
          everything except the annual Part B deductible ({MEDICARE_2026.partBDeductible} in {MEDICARE_2026.year}). After you pay
          that deductible, Plan G leaves you with very little to pay for Medicare-covered care, and you can use any provider
          nationwide that accepts Medicare.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Plan G is the plan most people newly eligible for Medicare end up comparing everything else against — for good reason.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>What Medicare Plan G covers</h2>
      <p>
        Plan G covers the Part A hospital deductible and coinsurance, Part B coinsurance, skilled nursing facility coinsurance, the
        first three pints of blood, hospice coinsurance, Part B excess charges, and foreign travel emergencies up to plan limits.
        In practice, that means after Medicare pays its share and you’ve met the Part B deductible, most Medicare-covered services
        cost you little to nothing.
      </p>

      <h2>What Plan G does not cover</h2>
      <p>
        The single gap is the annual Part B deductible ({MEDICARE_2026.partBDeductible} in {MEDICARE_2026.year}), which you pay
        yourself before coverage applies. Plan G also doesn’t include prescription drugs (you add a separate
        <a href="/services/prescription-drug-plans">Part D plan</a>) or routine dental, vision, and hearing.
      </p>

      <h2>Plan G is the same from every insurer</h2>
      <p>
        Because Medigap is standardized, a Plan G covers identical benefits no matter the company. That means you compare insurers
        on price, rate-increase history, and service — not coverage. An independent agent can line those up across the carriers
        available to you.
      </p>

      <h2>The lower-premium option: High-Deductible Plan G</h2>
      <p>
        If a standard Plan G premium feels high, <a href="/services/high-deductible-medicare-supplement">High-Deductible Plan G</a>
        offers the same coverage for a much lower premium, in exchange for a higher annual deductible. It’s worth comparing both —
        see <a href="/high-deductible-plan-g-vs-plan-g">High-Deductible Plan G vs. standard Plan G</a>.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want to compare Plan G options?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Related: <a href="/services/medicare-supplement">Medicare Supplement overview</a>,
        <a href="/medicare-plan-n">Plan N</a>, and the
        <a href="/medicare-supplement-plans-comparison">plans comparison</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          {MEDICARE_2026.year} figures are set by Medicare and change annually. Plan availability and pricing vary by insurer and
          location and are not guaranteed. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/health-drug-plans/medigap" rel="nofollow noopener" target="_blank">Medicare.gov — Medicare Supplement (Medigap)</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Is Plan G the right fit? Let’s talk it through." />
</BaseLayout>
