---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS } from '../data/site';

const title = 'Your Medicare Checklist Before You Turn 65';
const description = 'A simple, step-by-step Medicare checklist for the months before you turn 65 — what to review, what to decide, and when to act so you don’t miss a deadline.';
const today = '2026-06-03';

const faqs = [
  { q: 'What should I do before turning 65 for Medicare?', a: 'Review your current coverage, decide whether to enroll in Part A and Part B, choose your coverage path (Medigap plus Part D, or Medicare Advantage), compare your options, and enroll during your Initial Enrollment Period so coverage starts on time.' },
  { q: 'How far ahead should I start planning for Medicare?', a: 'About three months before your 65th birthday is a good time to start, since that’s when your Initial Enrollment Period opens. Starting early gives you time to compare options and avoid a rushed decision or a coverage gap.' },
  { q: 'Do I need to do anything if I already get Social Security?', a: 'If you’re already receiving Social Security before 65, you’re often enrolled in Parts A and B automatically. You still choose how to round out your coverage, so it’s worth reviewing your options even if enrollment is automatic.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/medicare-checklist-turning-65` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/medicare-checklist-turning-65#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Your Medicare Checklist Before 65"
    subtitle="A short, ordered list to keep your transition to Medicare smooth — and your deadlines safely met."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Turning 65', href: '/turning-65' }, { label: 'Pre-65 Checklist' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Want to walk the checklist together?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          Before you turn 65: <strong>review your current coverage, decide on Parts A and B, choose your coverage path, compare your
          options, and enroll on time.</strong> Starting about three months ahead — when your Initial Enrollment Period opens — keeps
          everything unhurried and on schedule.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        You don’t need to learn everything about Medicare — you just need to do a handful of things in the right order. Here they
        are.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>1. Review your current coverage</h2>
      <p>
        Note what you have now — employer coverage, retiree coverage, COBRA, or a marketplace plan — and when it ends. This tells you
        whether you should enroll in Part B right away or may qualify to delay it. If you’re still working, confirm whether your
        coverage counts as qualifying.
      </p>

      <h2>2. Decide on Part A and Part B</h2>
      <p>
        Most people take Part A at 65 because it’s usually premium-free. Whether to take Part B now depends on your other coverage.
        Get the building blocks in <a href="/medicare-basics">Medicare basics</a>.
      </p>

      <h2>3. Choose your coverage path</h2>
      <p>
        Decide how to round out Original Medicare: a <a href="/services/medicare-supplement">Medigap</a> plan plus a
        <a href="/services/prescription-drug-plans">Part D</a> plan, or a <a href="/services/medicare-advantage">Medicare
        Advantage</a> plan. Our <a href="/medicare-advantage-vs-medigap">Advantage vs. Medigap</a> guide compares them fairly.
      </p>

      <h2>4. Compare your options</h2>
      <p>
        Within your chosen path, compare specific plans on cost and fit. If you’re leaning Medigap, the
        <a href="/medicare-supplement-plans-comparison">plans comparison</a> is a good starting point. An independent agent can line
        up the options available to you.
      </p>

      <h2>5. Enroll on time</h2>
      <p>
        Enroll during your <a href="/medicare-initial-enrollment-period">Initial Enrollment Period</a> so coverage starts without a
        gap and you avoid late-enrollment penalties. Then you’re set.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want a hand working through the list?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Start with <a href="/turning-65">Turning 65 and Medicare</a> for the big picture.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          This checklist is educational and general; your steps may differ based on your coverage and circumstances. Enrollment
          rules reflect federal law as of 2026 and may change. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/basics/get-started-with-medicare" rel="nofollow noopener" target="_blank">Medicare.gov — Get started with Medicare</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Let’s work through your Medicare checklist" />
</BaseLayout>
