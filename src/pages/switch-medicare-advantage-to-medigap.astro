---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS } from '../data/site';

const title = 'Can You Switch From Medicare Advantage to Medigap?';
const description = 'You can switch from Medicare Advantage to Medigap, but timing and health matter — except in New York and Connecticut, where you can move to Medigap any time, no health questions.';
const today = '2026-06-03';

const faqs = [
  { q: 'Can you switch from Medicare Advantage to Medigap?', a: 'Yes, but it usually depends on timing and your health. You first move back to Original Medicare during an allowed enrollment period, then apply for Medigap. In most states that Medigap application requires medical underwriting; in New York and Connecticut it does not.' },
  { q: 'When can I leave a Medicare Advantage plan?', a: 'Common windows include the Annual Election Period in the fall and the Medicare Advantage Open Enrollment Period in early each year. Returning to Original Medicare is the first step; adding a Medigap plan is the second.' },
  { q: 'Will I need to pass medical underwriting to get Medigap?', a: 'In most states, yes, if you are outside a guaranteed-issue window — the insurer can review your health and decline you. In New York and Connecticut, Medigap is guaranteed issue year-round, so no health questions apply.' },
  { q: 'Are there trial rights to try Medicare Advantage and return to Medigap?', a: 'In some situations, yes. If you joined a Medicare Advantage plan when you first became eligible, or dropped a Medigap plan to try Advantage, you may have a limited trial-right window to return to Medigap with guaranteed issue. The rules are specific, so it’s worth confirming your situation.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/switch-medicare-advantage-to-medigap` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/switch-medicare-advantage-to-medigap#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Can You Switch From Medicare Advantage to Medigap?"
    subtitle="Often yes — but timing and your state decide how easy it is. Here’s how the move works, and why it’s simplest in New York and Connecticut."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Advantage vs. Medigap', href: '/medicare-advantage-vs-medigap' }, { label: 'Switching to Medigap' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Thinking about moving to Medigap?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          Yes, you can switch from <strong>Medicare Advantage to Medigap</strong> — but in most states it depends on timing and your
          health. You return to Original Medicare during an allowed window, then apply for a Medigap plan, which usually requires
          medical underwriting. In <strong>New York and Connecticut</strong>, that Medigap step is guaranteed issue year-round, with
          no health questions.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        This is one of the most important things to understand before you ever choose Medicare Advantage — because getting back to
        Medigap isn’t always automatic.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>How the switch works, step by step</h2>
      <p>
        There are two moves, not one. First, you leave your Medicare Advantage plan and return to Original Medicare during an allowed
        enrollment period — commonly the fall Annual Election Period or the Medicare Advantage Open Enrollment Period early in the
        year. Second, you apply for a Medigap plan (and usually a separate <a href="/services/prescription-drug-plans">Part D
        plan</a>). The second step is where state rules matter most.
      </p>

      <h2>The catch: medical underwriting in most states</h2>
      <p>
        Outside a guaranteed-issue window, most states let the Medigap insurer review your health history and charge more or decline
        you. That means a switch back isn’t guaranteed once you’re past your initial protections — a key reason to think carefully
        before leaving Medigap in the first place.
      </p>

      <h2>New York and Connecticut: no health questions</h2>
      <p>
        In these two states, Medigap is guaranteed issue all year, so the switch back is straightforward — you can move to a Medigap
        plan in any month without underwriting. See the <a href="/new-york-medicare-supplement">New York Medicare Supplement
        overview</a> and our <a href="/connecticut-medicare-supplement">Connecticut guide</a>.
      </p>

      <h2>Trial rights worth knowing about</h2>
      <p>
        Federal rules give some people limited “trial right” protections — for instance, if you tried Medicare Advantage when first
        eligible and want to return to Medigap within a set window. These rules are specific to your situation, so it’s worth
        confirming before you act.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want help planning the move?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Still deciding between the two? Read <a href="/medicare-advantage-vs-medigap">Medicare Advantage vs. Medigap</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Enrollment periods, trial rights, and guaranteed-issue rules reflect federal and New York/Connecticut law as of 2026 and
          may change. Approval in underwriting states is not guaranteed. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov" rel="nofollow noopener" target="_blank">Medicare.gov</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Considering a move to Medigap? Let’s review your options." />
</BaseLayout>
