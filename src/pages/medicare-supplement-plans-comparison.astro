---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS, MEDICARE_2026 } from '../data/site';

const title = 'Medicare Supplement Plans Comparison (2026)';
const description = 'Compare the most common Medicare Supplement (Medigap) plans side by side — Plan G, Plan N, and High-Deductible Plan G — to see what each covers and who it fits.';
const today = '2026-06-03';

const faqs = [
  { q: 'Which Medicare Supplement plan covers the most?', a: `Among plans available to people newly eligible, Plan G covers the most — every Medigap-eligible gap except the Part B deductible (${MEDICARE_2026.partBDeductible} in ${MEDICARE_2026.year}). Plan N covers nearly as much with a few small copays, for a lower premium.` },
  { q: 'Are Medigap plans the same from every company?', a: 'Yes. Each plan letter is standardized by law, so a Plan G or Plan N covers the same benefits no matter which insurer issues it. The differences come down to price, rate history, and service.' },
  { q: 'Can I still buy Plan F?', a: 'Only if you were eligible for Medicare before January 1, 2020. Plan F and Plan C are closed to anyone who became eligible on or after that date; Plan G is the comparable option for newer enrollees.' },
  { q: 'How do I choose between Medigap plans?', a: 'Because benefits are standardized, the choice comes down to how you want to balance premium against out-of-pocket costs, and then comparing insurers on price and service. A licensed agent can line up the options available to you.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: 'Medicare Supplement Plans Comparison (2026)', description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/medicare-supplement-plans-comparison` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/medicare-supplement-plans-comparison#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };

const rows = [
  ['Part A hospital deductible & coinsurance', 'Covered', 'Covered', 'Covered after deductible'],
  ['Part B coinsurance', 'Covered', 'Covered (small copays)', 'Covered after deductible'],
  ['Part B deductible', 'You pay', 'You pay', 'You pay (counts toward deductible)'],
  ['Part B excess charges', 'Covered', 'You pay', 'Covered after deductible'],
  ['Skilled nursing coinsurance', 'Covered', 'Covered', 'Covered after deductible'],
  ['Foreign travel emergency', 'Covered (limits)', 'Covered (limits)', 'Covered after deductible'],
  ['Monthly premium', 'Higher', 'Lower', 'Lowest of the three'],
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Medicare Supplement Plans Comparison"
    subtitle="The most common Medigap plans, side by side. Same standardized benefits — the difference is how you balance premium against what you pay when you use care."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Medicare Supplement', href: '/services/medicare-supplement' }, { label: 'Plans Comparison' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Want help comparing for your situation?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          The three Medigap options most people compare are <strong>Plan G</strong>, <strong>Plan N</strong>, and
          <strong>High-Deductible Plan G</strong>. Because benefits are standardized by law, they cover the same core things — the
          real difference is how each one balances your monthly premium against what you pay when you use care.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Here’s the side-by-side. Note that every plan of the same letter is identical across insurers, so this comparison holds no
        matter which company you choose.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <div class="not-prose my-6 overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="bg-crst-primary text-white">
              <th class="text-left p-3 font-heading font-semibold">Benefit</th>
              <th class="text-left p-3 font-heading font-semibold">Plan G</th>
              <th class="text-left p-3 font-heading font-semibold">Plan N</th>
              <th class="text-left p-3 font-heading font-semibold">High-Deductible G</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r, i) => (
              <tr class={i % 2 ? 'bg-navy-50' : 'bg-white'}>
                <td class="p-3 font-medium text-navy-700 border-b border-navy-100">{r[0]}</td>
                <td class="p-3 text-navy-600 border-b border-navy-100">{r[1]}</td>
                <td class="p-3 text-navy-600 border-b border-navy-100">{r[2]}</td>
                <td class="p-3 text-navy-600 border-b border-navy-100">{r[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>How to read the comparison</h2>
      <p>
        <a href="/medicare-plan-g">Plan G</a> covers the most for a higher premium. <a href="/medicare-plan-n">Plan N</a> lowers the
        premium in exchange for small copays and the Part B deductible. <a href="/services/high-deductible-medicare-supplement">High-Deductible
        Plan G</a> keeps Plan G’s coverage but carries a {MEDICARE_2026.hdDeductible} annual deductible ({MEDICARE_2026.year}) for
        the lowest premium of the three. None is universally best — it depends on your budget and how you use care.
      </p>

      <h2>A note on Plan F and Plan C</h2>
      <p>
        You may see Plan F and Plan C mentioned elsewhere. Both are closed to anyone who became eligible for Medicare on or after
        January 1, 2020. If you were eligible before then, you may still have access — see
        <a href="/high-deductible-plan-f-vs-plan-g">HD Plan F vs. HD Plan G</a> for the related distinction.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want these plans priced for you?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Start with the <a href="/services/medicare-supplement">Medicare Supplement overview</a> for how Medigap works.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          This comparison is general and educational; it is not a recommendation. Benefits are standardized but premiums and
          availability vary by insurer and location and are not guaranteed. {MEDICARE_2026.year} figures are set by Medicare and
          change annually. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/health-drug-plans/medigap" rel="nofollow noopener" target="_blank">Medicare.gov — Medicare Supplement (Medigap)</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Let’s compare the plans for your situation" />
</BaseLayout>
