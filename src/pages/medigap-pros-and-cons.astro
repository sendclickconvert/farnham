---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS } from '../data/site';

const title = 'Medigap Pros and Cons (2026)';
const description = 'A fair look at Medigap (Medicare Supplement) pros and cons — provider freedom and predictable costs on one side, higher premiums and separate drug coverage on the other.';
const today = '2026-06-03';

const faqs = [
  { q: 'What are the advantages of Medigap?', a: 'Freedom to use any provider nationwide that accepts Medicare, no networks or referrals, predictable and standardized costs, coverage that doesn’t change year to year, and guaranteed-renewable policies you keep as long as you pay the premium.' },
  { q: 'What are the disadvantages of Medigap?', a: 'A higher monthly premium than most Medicare Advantage plans, no built-in drug coverage (you add a separate Part D plan), no extras like dental or vision, and — in most states — medical underwriting if you apply outside your open enrollment window.' },
  { q: 'Is Medigap worth the higher premium?', a: 'For many people who value predictability and provider freedom, yes. You trade a higher premium for fewer surprises and the ability to see any doctor that accepts Medicare. Whether it’s worth it depends on your budget and how you use care.' },
  { q: 'Does Medigap cover prescriptions, dental, or vision?', a: 'No. Medigap covers the gaps in Original Medicare’s medical and hospital coverage. Prescriptions require a separate Part D plan, and dental, vision, and hearing are separate as well.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: 'Medigap Pros and Cons (2026)', description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/medigap-pros-and-cons` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/medigap-pros-and-cons#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Medigap Pros and Cons"
    subtitle="An even-handed look at what Medicare Supplement plans do well and where they ask for trade-offs."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Advantage vs. Medigap', href: '/medicare-advantage-vs-medigap' }, { label: 'Medigap Pros & Cons' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Want help weighing this for your situation?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          <strong>Medigap</strong> gives you provider freedom and predictable costs by paying the gaps in Original Medicare — in
          exchange for a higher monthly premium and separate drug coverage. For people who value stability and keeping their
          doctors, the trade-off is often worth it; for others, a lower-premium plan may fit better.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Medigap’s strengths are real, and so are its trade-offs. Here’s the honest version of both — and a couple of ways to manage
        the cost.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>The pros of Medigap</h2>
      <ul>
        <li><strong>Any-provider freedom.</strong> See any doctor or hospital in the country that accepts Medicare — no networks, no referrals.</li>
        <li><strong>Predictable costs.</strong> Standardized benefits mean fewer surprises when you use care.</li>
        <li><strong>Stability.</strong> Coverage doesn’t change year to year the way some plans do, and policies are guaranteed renewable.</li>
        <li><strong>Travel-friendly.</strong> Coverage follows you anywhere in the U.S. that accepts Medicare.</li>
      </ul>

      <h2>The cons of Medigap</h2>
      <ul>
        <li><strong>Higher premium.</strong> Monthly premiums are generally higher than Medicare Advantage.</li>
        <li><strong>Drugs are separate.</strong> You add a standalone <a href="/services/prescription-drug-plans">Part D plan</a>.</li>
        <li><strong>No bundled extras.</strong> Dental, vision, and hearing aren’t included.</li>
        <li><strong>Underwriting in most states.</strong> Outside your open enrollment window, many states require a health review — though <a href="/new-york-medicare-supplement">New York</a> and <a href="/connecticut-medicare-supplement">Connecticut</a> do not.</li>
      </ul>

      <h2>Managing the premium</h2>
      <p>
        If the premium is the sticking point, there are options that keep Medigap’s freedom for less:
        <a href="/medicare-plan-n">Plan N</a> trades small copays for a lower premium, and
        <a href="/services/high-deductible-medicare-supplement">High-Deductible Plan G</a> keeps full Plan G coverage for the lowest
        premium in exchange for a higher annual deductible.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want an honest comparison for your situation?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Compare directly in <a href="/medicare-advantage-vs-medigap">Medicare Advantage vs. Medigap</a> and the
        <a href="/medicare-advantage-pros-and-cons">Medicare Advantage pros and cons</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          This page is educational and general; plan benefits, costs, and availability vary by insurer and location and are not
          guaranteed. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/health-drug-plans/medigap" rel="nofollow noopener" target="_blank">Medicare.gov — Medicare Supplement (Medigap)</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Is Medigap right for you? Let’s talk it through." />
</BaseLayout>
