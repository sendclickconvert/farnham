---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS } from '../data/site';

const title = 'Medicare Part D Late-Enrollment Penalty Explained';
const description = 'The Medicare Part D late-enrollment penalty is a permanent amount added to your premium if you go without creditable drug coverage. Here’s how it works and how to avoid it.';
const today = '2026-06-03';

const faqs = [
  { q: 'What is the Medicare Part D late-enrollment penalty?', a: 'It is an amount permanently added to your Part D premium if you go 63 days or more without creditable prescription drug coverage after your Initial Enrollment Period. It’s calculated from how long you went without coverage and generally lasts as long as you have Part D.' },
  { q: 'How is the Part D penalty calculated?', a: 'The penalty is based on the number of full months you went without creditable coverage, multiplied by 1% of the “national base beneficiary premium” for the year. Because that base figure can change, your penalty amount can change year to year — and it’s added for as long as you have Part D.' },
  { q: 'How do I avoid the Part D penalty?', a: 'Enroll in a Part D plan when you’re first eligible, or keep coverage that Medicare considers creditable (such as some employer or retiree drug plans). As long as you don’t have a gap of 63 days or more, you won’t owe the penalty.' },
  { q: 'What counts as creditable drug coverage?', a: 'Creditable coverage is drug coverage Medicare considers at least as good as a standard Part D plan — often from an employer, union, or retiree plan. Your plan should send a notice each year stating whether it’s creditable; keep those notices.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: title, description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/medicare-part-d-late-enrollment-penalty` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/medicare-part-d-late-enrollment-penalty#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="The Part D Late-Enrollment Penalty"
    subtitle="A permanent cost you can avoid entirely with the right timing. Here’s how the penalty works and how to stay clear of it."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Part D Drug Plans', href: '/services/prescription-drug-plans' }, { label: 'Late-Enrollment Penalty' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Worried about a Part D penalty?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          The <strong>Part D late-enrollment penalty</strong> is a permanent amount added to your premium if you go
          <strong>63 days or more</strong> without creditable drug coverage after your Initial Enrollment Period. It’s based on how
          long you went without coverage, and it generally lasts for as long as you have Part D — so it’s worth avoiding from the
          start.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        This is one of the easiest Medicare mistakes to make and one of the easiest to avoid. Here’s exactly how it works.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>How the penalty is calculated</h2>
      <p>
        The penalty is roughly 1% of a national base premium for each full month you went without creditable coverage. Because that
        base figure is set each year, the dollar amount of your penalty can shift over time — and it’s added to your premium for as
        long as you stay enrolled in Part D. A short gap is inexpensive; a long one adds up.
      </p>

      <h2>How to avoid it</h2>
      <p>
        Two ways: enroll in a <a href="/services/prescription-drug-plans">Part D plan</a> when you’re first eligible, or keep
        coverage Medicare considers creditable. As long as you never have a gap of 63 days or more, there’s no penalty. Even if you
        take no medications today, a low-premium plan is cheap insurance against both future drug needs and the penalty.
      </p>

      <h2>What counts as creditable coverage</h2>
      <p>
        Creditable coverage is drug coverage at least as good as a standard Part D plan — often through an employer, union, or
        retiree plan. Your plan should notify you each year whether it’s creditable. Keep those notices; they’re your proof if a
        penalty is ever questioned.
      </p>

      <h2>Timing it with turning 65</h2>
      <p>
        The cleanest approach is to handle Part D as part of your <a href="/medicare-initial-enrollment-period">Initial Enrollment
        Period</a> when you turn 65, so there’s never a gap to worry about. See <a href="/turning-65">Turning 65 and Medicare</a> for
        the full sequence.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want to make sure you avoid the Part D penalty?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Penalty rules and the national base premium are set by Medicare and change annually; this is a general explanation, not a
          calculation of your specific penalty. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/drug-coverage-part-d/costs-for-medicare-drug-coverage/part-d-late-enrollment-penalty" rel="nofollow noopener" target="_blank">Medicare.gov — Part D late-enrollment penalty</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Let’s keep you clear of the Part D penalty" />
</BaseLayout>
