---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { BUSINESS, MEDICARE_2026 } from '../data/site';

const title = 'Medicare Part D Late-Enrollment Penalty Explained';
const description = 'The Medicare Part D late-enrollment penalty is a permanent amount added to your premium if you go without creditable drug coverage. Here\'s how it works and how to avoid it.';
const today = '2026-06-03';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: title, description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/medicare-part-d-late-enrollment-penalty` },
    { '@type': 'WebPage', '@id': `${BUSINESS.url}/medicare-part-d-late-enrollment-penalty#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="The Part D Late-Enrollment Penalty"
    subtitle="A permanent cost you can avoid entirely with the right timing."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Part D Drug Plans', href: '/services/prescription-drug-plans' }, { label: 'Late-Enrollment Penalty' }]}
  />

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          The <strong>Part D late-enrollment penalty</strong> is a permanent amount added to your premium if you go
          <strong>63 days or more</strong> without creditable drug coverage after your Initial Enrollment Period.
          Creditable coverage is drug coverage that's at least as good as a standard Part D plan — often through an employer,
          union, or retiree plan. Your plan should notify you each year whether it's creditable. Keep those notices;
          they're your proof if a penalty is ever questioned.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        The penalty is based on how long you went without coverage, and it generally lasts for as long as you have Part D —
        so it's worth avoiding from the start.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — Licensed Agent / Insurance Broker (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>How to avoid it</h2>
      <p>
        Two ways: enroll in a <a href="/services/prescription-drug-plans">Part D plan</a> when you're first eligible, or
        keep coverage Medicare considers creditable. As long as there's not a gap of 63 days or more, there's likely no
        penalty.
      </p>

      <h2>Timing it with turning 65</h2>
      <p>
        The cleanest approach is to handle Part D as part of your
        <a href="/medicare-initial-enrollment-period">Initial Enrollment Period</a> when you turn 65, so there's never a gap
        to worry about. See <a href="/turning-65">Turning 65 and Medicare</a> for the full sequence.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-2 m-0">Want to make sure you avoid the Part D penalty?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Penalty rules and the national base premium are set by Medicare and change annually. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/drug-coverage-part-d/costs-for-medicare-drug-coverage/part-d-late-enrollment-penalty" rel="nofollow noopener" target="_blank">Medicare.gov — Part D late-enrollment penalty</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Let's keep you clear of the Part D penalty." />
</BaseLayout>
