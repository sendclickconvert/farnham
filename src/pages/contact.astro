---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { BUSINESS, DISCLAIMERS, FORMS } from '../data/site';

const title = 'Contact Jim Farnham';
const description = 'Call or text directly, or request a no-cost Medicare review. Serving New York and Connecticut.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  mainEntity: { '@id': `${BUSINESS.url}/#organization` },
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Let’s Talk — No Pressure, Just Clarity"
    subtitle="Call or text me directly. Prefer I reach out? Send a few details and I’ll call you back as soon as possible."
    breadcrumbs={[{ label: 'Contact' }]}
  />

  <section class="py-14 lg:py-18">
    <div class="container-wide grid lg:grid-cols-2 gap-12">
      <!-- Direct contact -->
      <div>
        <h2 class="text-2xl font-display text-crst-primary mb-6">Reach me directly</h2>
        <div class="space-y-4">
          <a href={`tel:${BUSINESS.phoneClean}`} class="card flex items-center gap-4 hover:border-crst-accent">
            <div class="w-12 h-12 rounded-lg bg-crst-primary flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <p class="font-heading font-semibold text-crst-primary">Call or text</p>
              <p class="text-navy-600">{BUSINESS.phone}</p>
            </div>
          </a>
          <a href={`mailto:${BUSINESS.email}`} class="card flex items-center gap-4 hover:border-crst-accent">
            <div class="w-12 h-12 rounded-lg bg-crst-primary flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <p class="font-heading font-semibold text-crst-primary">Email</p>
              <p class="text-navy-600 break-all">{BUSINESS.email}</p>
            </div>
          </a>
          <div class="card flex items-start gap-4">
            <div class="w-12 h-12 rounded-lg bg-crst-primary flex items-center justify-center shrink-0">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <p class="font-heading font-semibold text-crst-primary">Availability</p>
              <p class="text-navy-600 text-sm">{BUSINESS.hours}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Lead form (no PHI) -->
      <div>
        <h2 class="text-2xl font-display text-crst-primary mb-6">Request a no-cost review</h2>
        <form
          class="card space-y-4"
          method="POST"
          action={FORMS.webhookUrl || '#'}
          data-form="lead"
        >
          <div>
            <label for="name" class="block text-sm font-heading font-medium text-navy-700 mb-1">Name</label>
            <input id="name" name="name" type="text" required autocomplete="name" class="w-full rounded-lg border border-navy-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-crst-accent" />
          </div>
          <div class="grid sm:grid-cols-2 gap-4">
            <div>
              <label for="phone" class="block text-sm font-heading font-medium text-navy-700 mb-1">Phone</label>
              <input id="phone" name="phone" type="tel" required autocomplete="tel" class="w-full rounded-lg border border-navy-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-crst-accent" />
            </div>
            <div>
              <label for="zip" class="block text-sm font-heading font-medium text-navy-700 mb-1">ZIP code</label>
              <input id="zip" name="zip" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" class="w-full rounded-lg border border-navy-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-crst-accent" />
            </div>
          </div>
          <div>
            <label for="email" class="block text-sm font-heading font-medium text-navy-700 mb-1">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" class="w-full rounded-lg border border-navy-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-crst-accent" />
          </div>
          <div>
            <label for="message" class="block text-sm font-heading font-medium text-navy-700 mb-1">How can I help? <span class="text-navy-400 font-normal">(optional)</span></label>
            <textarea id="message" name="message" rows="3" class="w-full rounded-lg border border-navy-200 px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-crst-accent"></textarea>
          </div>

          <!-- Consent (TCPA) -->
          <label class="flex items-start gap-3 text-xs text-navy-600">
            <input type="checkbox" name="consent" required class="mt-1 shrink-0" />
            <span>By submitting, I agree to be contacted by a licensed insurance agent by phone, text, email, or mail about Medicare plan options. Consent is not a condition of purchase.</span>
          </label>

          <button type="submit" class="btn-primary w-full">Request my call</button>

          <p class="text-xs text-navy-500 leading-relaxed border-t border-navy-100 pt-3">{DISCLAIMERS.noPHI}</p>
        </form>
      </div>
    </div>

    <div class="container-narrow mt-12">
      <Disclaimer variant="tpmo" />
    </div>
  </section>
</BaseLayout>
