---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import AuthorByline from '../components/AuthorByline.astro';
import { BUSINESS } from '../data/site';

const title = 'When Can You Enroll in Medigap? (Open Enrollment & Guaranteed Issue)';
const description = 'Your 6-month Medigap Open Enrollment Period is the most protected time to buy a Medicare Supplement plan. Here’s how it works — and why New York and Connecticut enroll year-round.';
const today = '2026-06-03';

const faqs = [
  { q: 'When is the Medigap Open Enrollment Period?', a: 'It is a one-time, 6-month window that starts the month you are both 65 or older and enrolled in Medicare Part B. During it you have guaranteed-issue rights — insurers cannot deny you or charge more based on your health.' },
  { q: 'What happens if I miss my Medigap Open Enrollment Period?', a: 'In most states, buying or switching Medigap after your open enrollment window usually requires medical underwriting, which means you can be charged more or declined based on your health. New York and Connecticut are exceptions — they allow guaranteed-issue enrollment year-round.' },
  { q: 'Can I be denied a Medigap plan?', a: 'During your Medigap Open Enrollment Period or a guaranteed-issue situation, no. Outside those windows in most states, an insurer can review your health and decline your application. In New York and Connecticut, you cannot be denied at any time of year.' },
  { q: 'Is Medigap guaranteed issue all year in New York?', a: 'Yes. New York and Connecticut require year-round, guaranteed-issue Medigap enrollment, so you can enroll or switch in any month without health questions.' },
];

const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: 'When Can You Enroll in Medigap?', description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/medigap-open-enrollment` };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/medigap-open-enrollment#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [articleSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="When Can You Enroll in Medigap?"
    subtitle="Timing matters with Medicare Supplement plans. Here’s the window that protects you — and the two states where the door stays open all year."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Medicare Supplement', href: '/services/medicare-supplement' }, { label: 'Open Enrollment' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Not sure about your enrollment timing?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          The most protected time to buy a Medigap plan is your <strong>6-month Medigap Open Enrollment Period</strong>, which begins the
          month you’re both 65 or older and enrolled in Part B. During it you have <strong>guaranteed-issue rights</strong> — you
          can’t be turned down or charged more for your health. New York and Connecticut go further, allowing guaranteed-issue
          enrollment <strong>year-round</strong>.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        With Medigap, when you enroll can matter as much as which plan you choose. Here’s what to know so you don’t miss your window.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>Your 6-month Medigap Open Enrollment Period</h2>
      <p>
        This one-time window opens the first month you’re 65 or older and enrolled in Medicare Part B, and it lasts six months.
        During it, insurers must sell you any Medigap plan they offer at their most favorable available rate, regardless of your health. It’s
        the single most protected time to enroll, which is why timing your Part B start date matters.
      </p>

      <h2>What happens if you miss it</h2>
      <p>
        In most states, applying for Medigap after your open enrollment window means going through medical underwriting — the
        insurer can review your health history and charge more or decline you. That’s why missing the window can be costly. There
        are some guaranteed-issue situations (for example, losing other coverage) that reopen protections, but they’re limited.
      </p>

      <h2>New York and Connecticut: open all year</h2>
      <p>
        These two states are the exception. Both require year-round, guaranteed-issue Medigap enrollment, so you can buy or switch in
        any month with no health questions and no risk of denial. If you live in either state, you have far more flexibility than
        most of the country — see the <a href="/new-york-medicare-supplement">New York Medicare Supplement overview</a> and our
        <a href="/connecticut-medicare-supplement">Connecticut guide</a>.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want help timing your enrollment?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Related: <a href="/services/medicare-supplement">Medicare Supplement overview</a> and
        <a href="/turning-65">turning 65 and Medicare</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Enrollment rules described here reflect federal and New York/Connecticut law as of 2026 and may change. Eligibility for
          guaranteed-issue situations depends on your circumstances. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/health-drug-plans/medigap/when-can-i-buy-medigap" rel="nofollow noopener" target="_blank">Medicare.gov — When can I buy Medigap?</a>
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Let’s make sure you don’t miss your window" />
</BaseLayout>
