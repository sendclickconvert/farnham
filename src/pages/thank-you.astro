---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BUSINESS } from '../data/site';
---

<BaseLayout title="Thank You" description="Thank you for reaching out." noIndex={true}>
  <section class="py-24 lg:py-32">
    <div class="container-narrow text-center">
      <div class="w-16 h-16 rounded-full bg-crst-gold/15 flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-crst-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      </div>
      <h1 class="text-3xl sm:text-4xl font-display text-crst-primary mb-4">Thank You — I’ll Be in Touch</h1>
      <p class="text-lg text-navy-600 max-w-xl mx-auto mb-8">
        Your request has been received. I’ll reach out as soon as possible. If you’d like to talk sooner, feel free to call or text me directly.
      </p>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-8 py-3.5">Call {BUSINESS.phone}</a>
      <p class="mt-8"><a href="/" class="text-crst-accent underline">Return to home</a></p>
    </div>
  </section>
</BaseLayout>
