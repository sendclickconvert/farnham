---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { BUSINESS, MEDICARE_2026 } from '../data/site';

const title = 'Can You Switch Out of High-Deductible Plan G Later?';
const description = 'In New York and Connecticut you can switch Medigap plans any time with no health questions. In most other states, switching later requires medical underwriting. Here\'s how it works.';
const today = '2026-06-03';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: title, description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/switch-high-deductible-plan-g-to-plan-g` },
    { '@type': 'WebPage', '@id': `${BUSINESS.url}/switch-high-deductible-plan-g-to-plan-g#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Can You Switch Out of High-Deductible Plan G Later?"
    subtitle="Where you live determines how easily you can change your mind. Here's what you need to know."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'High-Deductible Medigap', href: '/services/high-deductible-medicare-supplement' }, { label: 'Switching Plans' }]}
  />

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          In <strong>New York and Connecticut</strong>, you can change Medigap plans <strong>any time of year with no health
          questions and no underwriting</strong>. In most other states, switching after your initial 6-month Medigap window
          usually requires medical underwriting, and you could be declined.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        These two states have year-round, guaranteed-issue enrollment, so you can move between high-deductible and standard
        Plan G — or to a different plan entirely — in any month, without answering health questions and without the risk of
        being turned down. That means that choosing a High-Deductible Plan G now doesn't lock you in.
      </p>

      <h2>Switching in most other states</h2>
      <p>
        In most states outside New York and Connecticut, you get one guaranteed window — the six months after you turn 65
        and are enrolled in Medicare Part B. After that, switching Medigap plans usually requires medical underwriting. The
        insurer can review your health history and decline your application, so a switch later isn't guaranteed. That makes
        the initial choice more consequential in those states.
      </p>

      <h2>When switching makes sense</h2>
      <p>
        People most often consider switching when their health or budget changes, when a high-deductible plan no longer fits
        how they use care, or simply when a better-priced option becomes available. In guaranteed-issue states, it's
        reasonable to revisit your plan periodically because the door stays open.
      </p>

      <p>
        Here's a key rule: Don't drop your current coverage until your new plan is approved and in force. A licensed agent
        can line up the new plan, confirm the effective date, and make sure there's no gap. If you're in an underwriting
        state, it's worth checking your likelihood of approval before you apply.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-2 m-0">Want help reviewing whether to switch?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Switching rules reflect federal and state law as of {MEDICARE_2026.year} and may change. Approval in underwriting
          states is not guaranteed. NY producer license #: {BUSINESS.nyLicense}.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Thinking about switching? Let's review your options." />
</BaseLayout>
