---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { MEDICARE_2026 } from '../data/site';

const title = 'Medicare FAQ';
const description = 'Answers to common questions about High-Deductible Medigap, switching plans, costs, and consultations.';

const faqs = [
  { q: 'Is a high-deductible plan risky?', a: 'Not necessarily — it depends on your financial comfort level and how you use healthcare. You trade predictable higher premiums for controlled, conditional spending, and most people don’t reach the deductible every year.' },
  { q: 'Can I switch plans later?', a: 'It depends on your state and your health. In New York and Connecticut you can switch Medigap plans any time of year with no medical underwriting. In most other states, switching after your initial 6-month window may require medical underwriting, and approval is not guaranteed.' },
  { q: 'What if I get sick after enrolling?', a: 'Your Medicare Supplement coverage cannot be canceled because you get sick. However, in most states, switching to a different plan later may be limited by medical underwriting.' },
  { q: 'How much is the High-Deductible Plan G deductible?', a: `In ${MEDICARE_2026.year} it is ${MEDICARE_2026.hdDeductible}. The Part B deductible (${MEDICARE_2026.partBDeductible}) counts toward it. After the deductible is met, the plan pays 100% of Medicare-approved costs for the rest of the year.` },
  { q: 'Do you charge for consultations?', a: 'No — consultations are at no cost and come with no obligation.' },
  { q: 'Do you only work in New York?', a: 'New York and Connecticut are my primary focus, and I am also licensed in several other states. The easiest way to confirm I can help where you live is to call or request a review.' },
  { q: 'How do you get paid?', a: 'I may be compensated by insurance companies when you enroll in a plan. That compensation does not change the cost of your coverage.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout title={title} description={description} schema={faqSchema}>
  <PageHero title="Frequently Asked Questions" subtitle="Straight answers, no jargon." breadcrumbs={[{ label: 'FAQ' }]} />
  <section class="py-14 lg:py-18">
    <div class="container-narrow space-y-4">
      {faqs.map((f) => (
        <details class="group card cursor-pointer">
          <summary class="flex items-center justify-between font-heading font-semibold text-lg text-crst-primary list-none">
            {f.q}
            <svg class="w-5 h-5 shrink-0 text-crst-accent transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <p class="mt-3 text-navy-600 leading-relaxed">{f.a}</p>
        </details>
      ))}
      <div class="pt-6"><Disclaimer variant="tpmo" /></div>
    </div>
  </section>
  <CTASection />
</BaseLayout>
