---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS } from '../../data/site';

const title = 'Medicare Part D Prescription Drug Plans Explained';
const description = 'Medicare Part D covers prescription drugs through private plans. Learn how Part D works, what it costs, the new out-of-pocket cap, and how to avoid the late-enrollment penalty.';
const today = '2026-06-03';

const faqs = [
  { q: 'What is Medicare Part D?', a: 'Part D is prescription drug coverage offered through private plans approved by Medicare. You can add a standalone Part D plan to Original Medicare (often alongside a Medigap plan), or get drug coverage bundled inside most Medicare Advantage plans.' },
  { q: 'How much does Medicare Part D cost?', a: 'Costs vary by plan and include a monthly premium, a possible deductible, and copays or coinsurance based on the plan’s formulary tiers. Higher earners may pay an income-related amount added to the premium. Comparing total expected cost for your specific drugs matters more than premium alone.' },
  { q: 'Is there a cap on Part D out-of-pocket costs?', a: 'Yes. Starting in 2025, Part D includes an annual cap on what you pay out of pocket for covered drugs — about $2,000, set by Medicare and adjusted each year. Once you reach it, you pay nothing more for covered drugs for the rest of the year.' },
  { q: 'What is the Part D late-enrollment penalty?', a: 'If you go 63 days or more without creditable drug coverage after your Initial Enrollment Period, Medicare can add a permanent penalty to your Part D premium. Enrolling on time, or keeping creditable coverage, avoids it.' },
  { q: 'Do I need Part D if I take no medications?', a: 'Even if you take few or no drugs now, enrolling on time (or keeping creditable coverage) avoids the late-enrollment penalty later. A low-premium plan can serve as inexpensive protection against both future drug needs and the penalty.' },
];

const serviceSchema = { '@context': 'https://schema.org', '@type': 'Service', name: 'Medicare Part D Prescription Drug Plans', serviceType: 'Medicare Prescription Drug Plan', provider: { '@id': `${BUSINESS.url}/#organization` }, areaServed: [{ '@type': 'State', name: 'New York' }, { '@type': 'State', name: 'Connecticut' }], description };
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const speakableSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${BUSINESS.url}/services/prescription-drug-plans#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } };
const schema = { '@context': 'https://schema.org', '@graph': [serviceSchema, faqSchema, speakableSchema] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Medicare Part D (Prescription Drug Plans)"
    subtitle="How drug coverage works under Medicare — what it costs, the new out-of-pocket cap, and how to avoid the late-enrollment penalty."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Part D Drug Plans' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Questions about your drug coverage?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          <strong>Medicare Part D</strong> covers prescription drugs through private plans. You can add a standalone Part D plan to
          Original Medicare — often alongside a <a href="/services/medicare-supplement">Medigap</a> plan — or get drug coverage
          bundled inside most Medicare Advantage plans. Since 2025, Part D includes an annual cap on out-of-pocket drug costs.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Part D is the piece people put off, then regret skipping — because the penalty for enrolling late is permanent. Here’s how it
        works.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>How Medicare Part D works</h2>
      <p>
        Each Part D plan has a formulary — the list of drugs it covers, organized into tiers that determine your share of the cost.
        Plans differ in which drugs they cover and at what tier, so the plan that’s lowest-cost for your neighbor may not be the lowest-cost
        for you. The right plan depends on the specific medications you take.
      </p>

      <h2>What Part D costs</h2>
      <p>
        Expect a monthly premium, a possible deductible, and copays or coinsurance based on your plan’s tiers. Higher earners may pay
        an income-related amount on top of the premium. Because the variable is your own drug list, comparing total expected annual
        cost — not just the premium — is the way to choose.
      </p>

      <h2>The new out-of-pocket cap</h2>
      <p>
        Starting in 2025, Part D includes a yearly cap on what you pay out of pocket for covered drugs — about $2,000, set by
        Medicare and adjusted annually. Once you hit it, you pay nothing more for covered drugs for the rest of the year. This is a
        meaningful protection for anyone with high prescription costs.
      </p>

      <h2>Avoiding the late-enrollment penalty</h2>
      <p>
        If you go without creditable drug coverage for 63 days or more after your Initial Enrollment Period, Medicare can add a
        permanent penalty to your premium. Even if you take few medications, a low-premium plan avoids that risk — see the
        <a href="/medicare-part-d-late-enrollment-penalty">Part D late-enrollment penalty</a> guide for the details.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-3 m-0">Want help comparing Part D for your medications?</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p>
        Related: <a href="/medicare-basics">Medicare basics</a>,
        <a href="/services/medicare-supplement">Medicare Supplement</a>, and
        <a href="/turning-65">turning 65</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Plan costs, formularies, and the out-of-pocket cap are set by Medicare and plans and change annually; the cap figure is
          approximate and adjusted each year. This page is educational and not individualized advice. NY producer license #:
          {' '}{BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/drug-coverage-part-d" rel="nofollow noopener" target="_blank">Medicare.gov — Drug coverage (Part D)</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Let’s find the Part D plan that fits your medications" />
</BaseLayout>
