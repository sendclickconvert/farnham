---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { BUSINESS, MEDICARE_2026 } from '../../data/site';

const title = 'Medicare Supplement Insurance (Medigap)';
const description = 'A Medicare Supplement Insurance (Medigap) plan works alongside Original Medicare to pay the deductibles, copays, and coinsurance it leaves to you. Learn how it works and which plan fits you.';
const today = '2026-06-03';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Service', name: 'Medicare Supplement Insurance (Medigap)', serviceType: 'Medicare Supplement Insurance', provider: { '@id': `${BUSINESS.url}/#organization` }, areaServed: [{ '@type': 'State', name: 'New York' }, { '@type': 'State', name: 'Connecticut' }], description },
    { '@type': 'WebPage', '@id': `${BUSINESS.url}/services/medicare-supplement#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Medicare Supplement Insurance (Medigap)"
    subtitle="Private insurance that works alongside Original Medicare — paying the gaps it leaves behind, with the freedom to see any provider that accepts Medicare."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'Medicare Supplement Insurance (Medigap)' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Want help choosing the right Medigap plan?</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          A <strong>Medicare Supplement Insurance (Medigap)</strong> plan is private insurance that works alongside Original
          Medicare, helping to pay the deductibles, copays, and coinsurance Medicare leaves to you. Benefits are standardized
          by law. You can use any provider nationwide that accepts Medicare, and there are no networks or referrals. Drug
          coverage is separate.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Medigap is simple: it fills the gaps. The details are where people get stuck — so let's make them clear.
      </p>

      <h2>How Medigap works</h2>
      <p>
        Original Medicare (Part A and Part B) pays most of your covered costs, but it leaves behind a number of deductibles,
        copays, and coinsurances. In fact, if all you have is Original Medicare, there is no annual limit on what you would
        be responsible for. A Medigap plan pays its share of those leftover costs. The result: fewer surprise bills and more
        predictable spending.
      </p>

      <h2>What Medigap plans cover</h2>
      <p>
        Medigap plans are labeled by letter, and each letter is standardized — so Plan G covers the same core benefits from
        any insurer. See the full <a href="/medicare-supplement-plans-comparison">Medicare Supplement plans comparison</a>.
      </p>

      <h2>When you can enroll in Medigap</h2>
      <p>
        Nationwide, everyone has a 6-month Medigap Open Enrollment Period that begins when you're 65 or older and enrolled
        in Part B — during which, you can't be turned down. New York and Connecticut go further, allowing guaranteed-issue
        enrollment all year. See <a href="/medigap-open-enrollment">when you can enroll in Medigap</a>.
      </p>

      <h2>Medigap vs. Medicare Advantage</h2>
      <p>
        Because Original Medicare leaves deductibles and coinsurance with no annual limit, most people add coverage: either
        a Medigap plan plus Part D, or a Medicare Advantage plan. If you're choosing, our
        <a href="/medicare-advantage-vs-medigap">Medigap vs. Advantage</a> guide lays out both, and if you're new to all
        this, <a href="/turning-65">Turning 65 and Medicare</a> walks through the timing.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-2 m-0">Want help choosing the right Medigap plan?</p>
        <p class="text-white/70 text-sm mb-4 m-0">A no-cost, no-pressure comparison across the plans available to you.</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Plan availability, benefits, and costs vary by plan and location and are not guaranteed. Figures shown are
          {MEDICARE_2026.year} amounts and change annually. NY producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov/health-drug-plans/medigap" rel="nofollow noopener" target="_blank">Medicare.gov — Medicare Supplement (Medigap)</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Let's find the Medigap plan that fits you" />
</BaseLayout>
