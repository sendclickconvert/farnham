---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { BUSINESS, MEDICARE_2026 } from '../data/site';

const title = 'Is a High-Deductible Plan Worth it...the Pros & Cons';
const description = 'A fair look at High-Deductible Plan G pros and cons — lower premiums and real protection on one side, higher out-of-pocket costs on the other. Is it worth it for you?';
const today = '2026-06-03';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: title, description, author: { '@id': `${BUSINESS.url}/#agent` }, publisher: { '@id': `${BUSINESS.url}/#organization` }, datePublished: today, dateModified: today, mainEntityOfPage: `${BUSINESS.url}/high-deductible-plan-g-worth-it` },
    { '@type': 'WebPage', '@id': `${BUSINESS.url}/high-deductible-plan-g-worth-it#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } },
  ],
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Is a High-Deductible Plan Worth it...the Pros & Cons"
    subtitle="A fair, honest look at the trade-offs — so you can decide with clear eyes."
    breadcrumbs={[{ label: 'Medicare Plans', href: '/services' }, { label: 'High-Deductible Medigap', href: '/services/high-deductible-medicare-supplement' }, { label: 'Is It Worth It?' }]}
  />

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          Whether High-Deductible Plan G is worth it depends on your health, your budget, and where you live. There's no
          universal answer — only the right answer for your situation.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Here are the honest pros and cons, laid out plainly. Then let's look at your actual numbers.
      </p>

      <h2>High-Deductible Plan G</h2>
      <p><a href="/services/high-deductible-medicare-supplement">High-Deductible Medicare Supplement Insurance</a></p>

      <h2>The Pros</h2>
      <ul>
        <li><strong>A lower monthly premium</strong> than standard Plan G, which frees up cash every month.</li>
        <li><strong>The same standardized coverage</strong> as regular Plan G once you meet the deductible — it then pays 100% of Medicare-approved costs.</li>
        <li><strong>Protection against large bills.</strong> Your exposure in any year is capped at the deductible plus your low premium.</li>
        <li><strong>Flexibility</strong> — and in <a href="/new-york-medicare-supplement">New York and Connecticut</a>, you can change plans any time of year with no health questions.</li>
      </ul>

      <h2>The Cons</h2>
      <p>
        The trade-off is real: you pay more out of pocket before coverage kicks in. You cover Medicare's gaps yourself until
        your costs reach {MEDICARE_2026.hdDeductible} ({MEDICARE_2026.year}), so you need the cash flow to handle a heavy-care year.
      </p>
      <p>
        In a heavy-care year, the most you'd pay is your lower annual premium <strong>plus</strong> the {MEDICARE_2026.hdDeductible}
        deductible. In a light-care year, you still pay the lower premium plus a lower amount for care. Compare either of
        those against a full year of standard Plan G premiums. Because the deductible is fixed and there are savings with the
        premium, even after paying the higher deductible, you're still ahead financially.
      </p>
      <p>
        The piece that varies is the actual premium, which depends on the insurer and your area, so the honest way to finish
        the math is with real quotes. I'm glad to <a href="/contact">pull those for you</a> at no cost.
      </p>

      <div class="not-prose my-10 rounded-xl bg-crst-primary p-6 text-center">
        <p class="text-white font-heading text-lg mb-2 m-0">Let's settle the "is it worth it" question with real numbers.</p>
        <p class="text-white/70 text-sm mb-4 m-0">No cost, no obligation, no pressure.</p>
        <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3">Call {BUSINESS.phone}</a>
      </div>

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          High-Deductible Plan G involves higher out-of-pocket costs before coverage begins and is not suitable for everyone.
          The {MEDICARE_2026.hdDeductible} figure is the {MEDICARE_2026.year} deductible set by Medicare and changes annually.
          NY producer license #: {BUSINESS.nyLicense}.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Real numbers, real comparison — at no cost." />
</BaseLayout>
