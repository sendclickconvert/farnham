---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, MEDICARE_2026 } from '../../data/site';

const title = 'Medicare in Dutchess County, NY — Local Agent';
const description = 'Local Medicare help for Dutchess County, NY — Poughkeepsie, Beacon, Rhinebeck, Hyde Park and beyond. Independent guidance on Medigap, High-Deductible Plan G, Advantage, and Part D.';
const today = '2026-06-03';

const faqs = [
  { q: 'Is there a local Medicare agent serving Dutchess County?', a: 'Yes. Jim Farnham works with Medicare beneficiaries across Dutchess County — Poughkeepsie, Beacon, Rhinebeck, Hyde Park, Wappingers Falls, Fishkill, and the surrounding towns — from nearby New Paltz, mostly by phone and Zoom, with in-person meetings by appointment.' },
  { q: 'Can I keep my doctors at Vassar Brothers with Medicare?', a: 'With a Medicare Supplement (Medigap) plan, yes — you can use Vassar Brothers Medical Center in Poughkeepsie, Northern Dutchess Hospital in Rhinebeck, or any provider nationwide that accepts Medicare, with no network and no referrals. Medicare Advantage plans generally use a network, so check first if a specific local doctor matters to you.' },
  { q: 'When can I change my Medicare plan in Dutchess County?', a: 'Because New York offers year-round, guaranteed-issue Medigap enrollment, Dutchess County residents can review or switch a Medicare Supplement plan in any month with no health questions. Medicare Advantage and Part D follow the federal enrollment windows.' },
  { q: 'Do we have to meet in person?', a: 'No. Most Dutchess County clients prefer a phone call or a Zoom screen-share where we look at the numbers together, with in-person available by appointment.' },
];

const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Service', name: 'Medicare Insurance Guidance in Dutchess County', serviceType: 'Medicare Supplement Insurance', provider: { '@id': `${BUSINESS.url}/#organization` }, areaServed: { '@type': 'AdministrativeArea', name: 'Dutchess County, New York' }, description },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'Service Areas', item: `${BUSINESS.url}/service-areas` }, { '@type': 'ListItem', position: 2, name: 'Dutchess County', item: `${BUSINESS.url}/service-areas/dutchess-county` } ] },
  { '@type': 'WebPage', '@id': `${BUSINESS.url}/service-areas/dutchess-county#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } },
] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Medicare in Dutchess County"
    subtitle="From Poughkeepsie and Beacon to Rhinebeck and Hyde Park, I help Dutchess County residents understand their Medicare options and choose coverage that fits."
    breadcrumbs={[{ label: 'Service Areas', href: '/service-areas' }, { label: 'Dutchess County' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Independent, local Medicare guidance for Dutchess.</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          <strong>Medicare help across Dutchess County, from a Hudson Valley neighbor.</strong> Jim Farnham works with beneficiaries
          from Poughkeepsie to Rhinebeck, comparing real total costs — not just premiums — and explaining your choices plainly. The
          first conversation is no-cost and carries no obligation.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Dutchess sits just across the river from home, so I know the area and the way coverage actually plays out here. Here’s how I
        help, and why New York’s rules work in your favor.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>The Dutchess County towns I serve</h2>
      <p>
        I work with people in Poughkeepsie, Beacon, Rhinebeck, and Hyde Park, out through Wappingers Falls, Fishkill, Red Hook,
        Millbrook, and Pleasant Valley — anywhere in the county. With most reviews done by phone or video, your town never limits the
        help; it just frames the local picture we walk through.
      </p>

      <h2>Keep your doctors — Vassar Brothers, Northern Dutchess, and any Medicare provider</h2>
      <p>
        Locally, this is the heart of it. With a <a href="/services/medicare-supplement">Medicare Supplement (Medigap)</a> plan, you
        can use Vassar Brothers Medical Center in Poughkeepsie — the county’s main hospital and a Level II trauma center, now part of
        Northwell Health — or Northern Dutchess Hospital in Rhinebeck, or any doctor anywhere in the country that accepts Medicare,
        with no network and no referrals. Medicare Advantage plans usually work through a network, so if you have a specialist you
        want to keep, that distinction matters. See <a href="/medicare-advantage-vs-medigap">Medicare Advantage vs. Medigap</a> for
        the honest comparison.
      </p>

      <h2>The New York advantage, in Dutchess County</h2>
      <p>
        New York is one of only two states (with Connecticut) with year-round, guaranteed-issue Medigap and community-rated pricing.
        For Dutchess residents, that means you can review or switch a Medigap plan any month with no health questions, and your age
        and health can’t raise your premium. The full detail is on our <a href="/new-york-medicare-supplement">New York Medicare
        Supplement</a> page.
      </p>

      <h2>Where High-Deductible Plan G fits</h2>
      <p>
        Because community rating tends to lift Medigap premiums in New York, the lower-premium
        <a href="/services/high-deductible-medicare-supplement">High-Deductible Plan G</a> ({MEDICARE_2026.hdDeductible} deductible
        in {MEDICARE_2026.year}) is often worth comparing here — the same any-provider freedom for a smaller monthly cost. It suits
        some situations and not others; we’d look at your numbers to know.
      </p>

      <h2>Two hospital systems, one simple rule</h2>
      <p>
        Dutchess residents are served mainly by Vassar Brothers and Northern Dutchess — both now under Northwell after the recent
        merger — and that kind of consolidation is exactly why provider flexibility matters. When systems combine and networks shift,
        a Medicare Advantage plan that included your doctors last year may not next year. A Medigap plan sidesteps that entirely: as
        long as a provider accepts Medicare, you’re covered, no matter which system owns the building this year. For a county that has
        seen real change in who runs its hospitals, that stability is worth something. We’d look at which doctors you want to keep and
        make sure your coverage protects that choice.
      </p>

      <h2>How we meet</h2>
      <p>
        A phone call or a Zoom screen-share is how most reviews happen, with in-person by appointment. You’ll have my direct line
        afterward. <a href="/contact">Request a no-cost review</a> or call {BUSINESS.phone}.
      </p>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p class="text-sm text-navy-500">
        Nearby: <a href="/service-areas/ulster-county">Ulster County</a> ·
        <a href="/service-areas/orange-county">Orange County</a> ·
        <a href="/service-areas">all service areas</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Hospitals are named as local context only; this site is not affiliated with or endorsed by any hospital or health system.
          Plan availability, benefits, and costs vary and are not guaranteed; {MEDICARE_2026.year} figures change annually. NY
          producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov" rel="nofollow noopener" target="_blank">Medicare.gov</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Medicare questions in Dutchess County? Let’s talk." />
</BaseLayout>
