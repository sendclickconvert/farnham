---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, MEDICARE_2026 } from '../../data/site';

const title = 'Medicare in Ulster County, NY — Local Agent';
const description = 'Local Medicare help for Ulster County, NY — New Paltz, Kingston, Saugerties, Woodstock and beyond. Independent guidance on Medigap, High-Deductible Plan G, Advantage, and Part D.';
const today = '2026-06-03';

const faqs = [
  { q: 'Is there a local Medicare agent in Ulster County?', a: 'Yes. Jim Farnham is based in New Paltz and works with Medicare beneficiaries throughout Ulster County — New Paltz, Kingston, Saugerties, Woodstock, Highland, Ellenville, and the surrounding towns. Most reviews happen by phone or Zoom, with in-person meetings available by appointment.' },
  { q: 'Can I keep my doctors at HealthAlliance Hospital with Medicare?', a: 'With a Medicare Supplement (Medigap) plan, yes — you can use HealthAlliance Hospital in Kingston, or any doctor or hospital in the country that accepts Medicare, with no network and no referrals. Medicare Advantage plans, by contrast, generally use a network, so it’s worth checking before you choose.' },
  { q: 'When can I change my Medicare plan in Ulster County?', a: 'New York is one of only two states with year-round, guaranteed-issue Medicare Supplement enrollment, so Ulster County residents can review or switch a Medigap plan in any month with no health questions. Medicare Advantage and Part D changes follow the federal enrollment windows.' },
  { q: 'Do we have to meet in person?', a: 'No. Most Ulster County clients prefer a phone call or a Zoom screen-share where we look at the numbers together. In-person meetings are available by appointment if you’d rather sit down.' },
];

const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Service', name: 'Medicare Insurance Guidance in Ulster County', serviceType: 'Medicare Supplement Insurance', provider: { '@id': `${BUSINESS.url}/#organization` }, areaServed: { '@type': 'AdministrativeArea', name: 'Ulster County, New York' }, description },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'Service Areas', item: `${BUSINESS.url}/service-areas` }, { '@type': 'ListItem', position: 2, name: 'Ulster County', item: `${BUSINESS.url}/service-areas/ulster-county` } ] },
  { '@type': 'WebPage', '@id': `${BUSINESS.url}/service-areas/ulster-county#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } },
] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Medicare in Ulster County"
    subtitle="This is home. From New Paltz and Kingston to Woodstock and Ellenville, I help Ulster County neighbors choose Medicare coverage that fits — without the pressure of a national call center."
    breadcrumbs={[{ label: 'Service Areas', href: '/service-areas' }, { label: 'Ulster County' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">A local agent, right here in New Paltz.</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          <strong>Medicare help in Ulster County, from someone who actually lives here.</strong> Jim Farnham is based in New Paltz and
          works with beneficiaries across the county — comparing real costs, not just premiums, and explaining your options in plain
          language. The first conversation is free and carries no obligation.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Ulster County is home base, so the local details aren’t guesswork — they’re where I live and teach. Here’s how I help, and
        what makes Medicare in New York work in your favor.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}), based in New Paltz.
      </p>

      <h2>The Ulster County towns I serve</h2>
      <p>
        I work with people in New Paltz, Kingston, Saugerties, and Woodstock, out to Highland, Ellenville, Gardiner, Rosendale,
        Hurley, and Marlboro — really, anywhere in the county. Because the practice is built around phone and video, where you live
        in Ulster never limits the help you get; it just shapes the local context we talk through.
      </p>

      <h2>Keep your doctors — HealthAlliance and any provider that takes Medicare</h2>
      <p>
        This is the part that matters most locally. With a <a href="/services/medicare-supplement">Medicare Supplement (Medigap)</a>
        plan, you can use HealthAlliance Hospital in Kingston (the county’s main hospital, part of the WMCHealth network and long
        known here as Kingston Hospital), Ellenville Regional Hospital, Margaretville Hospital, or any doctor or specialist in the
        country that accepts Medicare — with no network and no referrals. Medicare Advantage plans generally route you through a
        network instead, so if keeping a specific local doctor matters to you, that difference is worth understanding before you
        decide. Our guide to <a href="/medicare-advantage-vs-medigap">Medicare Advantage vs. Medigap</a> lays both out fairly.
      </p>

      <h2>The New York advantage, in Ulster County</h2>
      <p>
        New York is one of only two states (with Connecticut) that offer year-round, guaranteed-issue Medigap enrollment and
        community-rated pricing. For you, that means you can review or switch a Medigap plan in any month, with no health questions,
        and your age and health can’t be used to raise your premium. It’s a genuine advantage most of the country doesn’t have — the
        full explanation is on our <a href="/new-york-medicare-supplement">New York Medicare Supplement</a> page.
      </p>

      <h2>Where High-Deductible Plan G fits</h2>
      <p>
        Because New York’s community rating tends to lift Medigap premiums, the lower-premium
        <a href="/services/high-deductible-medicare-supplement">High-Deductible Plan G</a> (with its {MEDICARE_2026.hdDeductible}
        deductible in {MEDICARE_2026.year}) is often worth a close look here — you keep the same any-provider freedom for a much
        smaller monthly cost. Whether it makes sense depends on your health and budget; it isn’t right for everyone.
      </p>

      <h2>How we meet</h2>
      <p>
        Most folks prefer a quick phone call or a Zoom screen-share where we look at options together; in-person is available by
        appointment. Either way, you’ll get my direct line afterward — not a call-center queue. <a href="/contact">Request a no-cost
        review</a> or call {BUSINESS.phone}.
      </p>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p class="text-sm text-navy-500">
        Nearby: <a href="/service-areas/dutchess-county">Dutchess County</a> ·
        <a href="/service-areas/orange-county">Orange County</a> ·
        <a href="/service-areas">all service areas</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Hospitals are named as local context only; this site is not affiliated with or endorsed by any hospital or health system.
          Plan availability, benefits, and costs vary and are not guaranteed; {MEDICARE_2026.year} figures change annually. NY
          producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov" rel="nofollow noopener" target="_blank">Medicare.gov</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Medicare questions in Ulster County? Let’s talk." />
</BaseLayout>
