---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, MEDICARE_2026 } from '../../data/site';

const title = 'Medicare in Orange County, NY — Local Agent';
const description = 'Local Medicare help for Orange County, NY — Middletown, Newburgh, Goshen, Warwick and beyond. Independent guidance on Medigap, High-Deductible Plan G, Advantage, and Part D.';
const today = '2026-06-03';

const faqs = [
  { q: 'Is there a local Medicare agent serving Orange County?', a: 'Yes. Jim Farnham works with Medicare beneficiaries throughout Orange County — Middletown, Newburgh, Goshen, Warwick, Monroe, Chester, and the surrounding towns — primarily by phone and Zoom, with in-person meetings by appointment.' },
  { q: 'Can I keep my doctors at Garnet Health with Medicare?', a: 'With a Medicare Supplement (Medigap) plan, yes — you can use Garnet Health Medical Center in Middletown, Montefiore St. Luke’s Cornwall in Newburgh, or any provider nationwide that accepts Medicare, with no network and no referrals. Medicare Advantage plans generally use a network, so check first if a specific local doctor matters to you.' },
  { q: 'When can I change my Medicare plan in Orange County?', a: 'New York offers year-round, guaranteed-issue Medigap enrollment, so Orange County residents can review or switch a Medicare Supplement plan in any month with no health questions. Medicare Advantage and Part D changes follow the federal enrollment windows.' },
  { q: 'Do we have to meet in person?', a: 'No. Most Orange County clients prefer a phone call or a Zoom screen-share where we look at the numbers together, with in-person available by appointment.' },
];

const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Service', name: 'Medicare Insurance Guidance in Orange County', serviceType: 'Medicare Supplement Insurance', provider: { '@id': `${BUSINESS.url}/#organization` }, areaServed: { '@type': 'AdministrativeArea', name: 'Orange County, New York' }, description },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'Service Areas', item: `${BUSINESS.url}/service-areas` }, { '@type': 'ListItem', position: 2, name: 'Orange County', item: `${BUSINESS.url}/service-areas/orange-county` } ] },
  { '@type': 'WebPage', '@id': `${BUSINESS.url}/service-areas/orange-county#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } },
] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Medicare in Orange County"
    subtitle="From Middletown and Newburgh to Goshen and Warwick, I help Orange County residents make sense of Medicare and choose coverage that fits their lives and budgets."
    breadcrumbs={[{ label: 'Service Areas', href: '/service-areas' }, { label: 'Orange County' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Independent, local Medicare guidance for Orange.</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          <strong>Medicare help across Orange County, from a Hudson Valley neighbor.</strong> Jim Farnham works with beneficiaries
          from Middletown to Warwick, comparing real total costs — not just premiums — and explaining your options plainly. The first
          conversation is no-cost and carries no obligation.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Orange County spans a lot of ground — small cities, river towns, and apple country — and the right Medicare choice looks
        different for each. Here’s how I help, and why New York’s rules work in your favor.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>The Orange County towns I serve</h2>
      <p>
        I work with people in Middletown, Newburgh, Goshen, and Warwick, out through Monroe, Chester, Port Jervis, Montgomery,
        Walden, and Cornwall — anywhere in the county. With most reviews done by phone or video, your town never limits the help; it
        just shapes the local context we discuss.
      </p>

      <h2>Keep your doctors — Garnet Health, Montefiore St. Luke’s Cornwall, and any Medicare provider</h2>
      <p>
        This is where it gets practical. With a <a href="/services/medicare-supplement">Medicare Supplement (Medigap)</a> plan, you
        can use Garnet Health Medical Center in Middletown (the county’s main hospital, long known here as Orange Regional),
        Montefiore St. Luke’s Cornwall in Newburgh, or any doctor anywhere that accepts Medicare — no network, no referrals. Medicare
        Advantage plans generally route through a network, so if you want to keep a specific local doctor, that difference is worth
        weighing. Our <a href="/medicare-advantage-vs-medigap">Medicare Advantage vs. Medigap</a> guide lays both out fairly.
      </p>

      <h2>The New York advantage, in Orange County</h2>
      <p>
        New York is one of only two states (with Connecticut) with year-round, guaranteed-issue Medigap and community-rated pricing.
        For Orange County residents, that means you can review or switch a Medigap plan any month with no health questions, and your
        age and health can’t raise your premium. The full explanation lives on our <a href="/new-york-medicare-supplement">New York
        Medicare Supplement</a> page.
      </p>

      <h2>Where High-Deductible Plan G fits</h2>
      <p>
        Because community rating tends to lift Medigap premiums here, the lower-premium
        <a href="/services/high-deductible-medicare-supplement">High-Deductible Plan G</a> ({MEDICARE_2026.hdDeductible} deductible
        in {MEDICARE_2026.year}) is often worth comparing — the same any-provider freedom for a smaller monthly cost. Whether it fits
        depends on your health and budget; it isn’t right for everyone.
      </p>

      <h2>A county too spread out for one network</h2>
      <p>
        Orange County runs from the small cities of Middletown and Newburgh to rural Warwick and Goshen, out to Port Jervis on the
        Pennsylvania line — and that spread matters for coverage. Garnet Health anchors Middletown and Montefiore St. Luke’s Cornwall
        serves the Newburgh side, but depending on where you live, your preferred specialists might be in different directions, or even
        across a state line. Medicare Advantage networks don’t always stretch neatly across a county this varied. A Medigap plan’s
        any-provider freedom means geography stops being a constraint — you choose the doctor, not the network map. We’d factor in
        where you live and where you actually go for care.
      </p>

      <h2>How we meet</h2>
      <p>
        Most reviews happen by phone or Zoom screen-share, with in-person by appointment — and you’ll have my direct line afterward.
        <a href="/contact">Request a no-cost review</a> or call {BUSINESS.phone}.
      </p>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p class="text-sm text-navy-500">
        Nearby: <a href="/service-areas/dutchess-county">Dutchess County</a> ·
        <a href="/service-areas/ulster-county">Ulster County</a> ·
        <a href="/service-areas">all service areas</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Hospitals are named as local context only; this site is not affiliated with or endorsed by any hospital or health system.
          Plan availability, benefits, and costs vary and are not guaranteed; {MEDICARE_2026.year} figures change annually. NY
          producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov" rel="nofollow noopener" target="_blank">Medicare.gov</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Medicare questions in Orange County? Let’s talk." />
</BaseLayout>
