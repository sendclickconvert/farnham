---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { COUNTIES, BUSINESS, MEDICARE_2026 } from '../../data/site';

export const prerender = true;

export function getStaticPaths() {
  return Object.values(COUNTIES).map((county) => ({
    params: { county: county.slug },
    props: { county },
  }));
}

const { county } = Astro.props;
const title = `Medicare Help in ${county.name}, NY`;
const description = `Local Medicare guidance for ${county.name} residents — High-Deductible Medigap, Medicare Supplement, Medicare Advantage, and Part D. No-pressure reviews by phone, Zoom, or appointment.`;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Medicare Insurance Guidance in ${county.name}`,
  serviceType: 'Medicare Supplement Insurance',
  provider: { '@id': `${BUSINESS.url}/#organization` },
  areaServed: { '@type': 'AdministrativeArea', name: `${county.name}, New York` },
  description,
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title={`Medicare Help in ${county.name}`}
    subtitle={county.description}
    breadcrumbs={[{ label: 'Service Areas', href: '/service-areas' }, { label: county.name }]}
  />
  <section class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">
      <p class="lead text-xl text-navy-700">
        If you live in or around {county.anchor} or anywhere in {county.name}, I can help you understand your Medicare options and
        choose coverage that fits — without the pressure of a national call center.
      </p>

      <h2>A New York advantage worth knowing about</h2>
      <p>
        New York is one of only two states (along with Connecticut) with year-round, guaranteed-issue Medicare Supplement
        enrollment and community-rated pricing. For {county.name} residents, that means you can review and switch your Medigap
        coverage at any time of year — with no health questions — and your age and health can’t be used to raise your premium.
        It’s also part of why a <a href="/services/high-deductible-medicare-supplement">High-Deductible Medigap plan</a> (with its
        {' '}{MEDICARE_2026.hdDeductible} {MEDICARE_2026.year} deductible) can be especially worth a look here.
      </p>

      <h2>How we can meet</h2>
      <p>
        Most {county.name} clients prefer a quick phone call or a Zoom screen-share where we can look at options together. In-person
        meetings are available by appointment. Either way, the first conversation is at no cost and carries no obligation.
      </p>

      <h2>What we’ll cover</h2>
      <ul>
        <li>How Original Medicare, Medigap, Medicare Advantage, and Part D fit together</li>
        <li>Whether a high-deductible approach makes financial sense for you</li>
        <li>Your real total annual cost — premium plus out-of-pocket — not just the monthly premium</li>
        <li>Any timing or enrollment windows that apply to your situation</li>
      </ul>

      <p><a href="/contact">Request a no-cost review</a> or call {BUSINESS.phone} to get started.</p>

      <div class="not-prose mt-8"><Disclaimer variant="tpmo" /></div>
    </div>
  </section>
  <CTASection headline={`Medicare questions in ${county.name}? Let’s talk.`} />
</BaseLayout>
