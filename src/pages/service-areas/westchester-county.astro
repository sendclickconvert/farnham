---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTASection from '../../components/CTASection.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BUSINESS, MEDICARE_2026 } from '../../data/site';

const title = 'Medicare in Westchester County, NY — Local Agent';
const description = 'Local Medicare help for Westchester County, NY — White Plains, Yonkers, New Rochelle, Mount Vernon and beyond. Independent guidance on Medigap, High-Deductible Plan G, Advantage, and Part D.';
const today = '2026-06-03';

const faqs = [
  { q: 'Is there a local Medicare agent serving Westchester County?', a: 'Yes. Jim Farnham works with Medicare beneficiaries across Westchester County — White Plains, Yonkers, New Rochelle, Mount Vernon, and the surrounding communities — by phone and Zoom screen-share.' },
  { q: 'Can I keep my doctors at White Plains Hospital with Medicare?', a: 'With a Medicare Supplement (Medigap) plan, yes — you can use White Plains Hospital, St. John’s Riverside in Yonkers, the Montefiore Westchester hospitals, or any provider nationwide that accepts Medicare, with no network and no referrals. Medicare Advantage plans generally use a network, which matters in a dense market like Westchester.' },
  { q: 'When can I change my Medicare plan in Westchester County?', a: 'New York offers year-round, guaranteed-issue Medigap enrollment, so Westchester residents can review or switch a Medicare Supplement plan in any month with no health questions. Medicare Advantage and Part D changes follow the federal enrollment windows.' },
  { q: 'There’s so much Medicare Advantage advertising here — is Medigap still an option?', a: 'Absolutely. Westchester sees heavy Medicare Advantage marketing because of its proximity to New York City, but Medigap is fully available and, thanks to New York’s rules, can be entered or switched year-round. Which fits you depends on whether you value provider freedom and predictability or a lower premium with a network.' },
];

const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Service', name: 'Medicare Insurance Guidance in Westchester County', serviceType: 'Medicare Supplement Insurance', provider: { '@id': `${BUSINESS.url}/#organization` }, areaServed: { '@type': 'AdministrativeArea', name: 'Westchester County, New York' }, description },
  { '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@type': 'BreadcrumbList', itemListElement: [ { '@type': 'ListItem', position: 1, name: 'Service Areas', item: `${BUSINESS.url}/service-areas` }, { '@type': 'ListItem', position: 2, name: 'Westchester County', item: `${BUSINESS.url}/service-areas/westchester-county` } ] },
  { '@type': 'WebPage', '@id': `${BUSINESS.url}/service-areas/westchester-county#webpage`, name: title, speakable: { '@type': 'SpeakableSpecification', cssSelector: ['.lead', 'h2'] } },
] };
---

<BaseLayout title={title} description={description} schema={schema}>
  <PageHero
    title="Medicare in Westchester County"
    subtitle="From White Plains and Yonkers to New Rochelle and Mount Vernon, I help Westchester residents cut through the noise and choose Medicare coverage that actually fits."
    breadcrumbs={[{ label: 'Service Areas', href: '/service-areas' }, { label: 'Westchester County' }]}
  />

  <div class="bg-crst-light border-b border-navy-100">
    <div class="container-wide py-3 flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-4 text-center">
      <span class="text-sm font-heading text-navy-700">Independent guidance, not a call center.</span>
      <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-sm px-5 py-2">Call or text {BUSINESS.phone}</a>
    </div>
  </div>

  <article class="py-14 lg:py-18">
    <div class="container-narrow prose prose-lg max-w-none prose-headings:font-display prose-headings:text-crst-primary prose-a:text-crst-accent">

      <div class="not-prose mb-8 rounded-xl border-l-4 border-crst-gold bg-navy-50 p-5">
        <p class="text-navy-800 leading-relaxed m-0">
          <strong>Independent Medicare help across Westchester County.</strong> In a market flooded with national advertising, Jim
          Farnham offers something different — a real person who compares your actual total costs, explains the trade-offs plainly,
          and isn’t a call center. The first conversation is no-cost and carries no obligation.
        </p>
      </div>

      <p class="lead text-xl text-navy-700">
        Westchester is the busiest, most heavily marketed Medicare market in our service area — which is exactly why a calm,
        independent second opinion is worth having. Here’s how I help.
      </p>
      <p class="text-sm text-navy-500 -mt-2">
        Written by <a href="/about">Jim Farnham, MS, MBA</a> — licensed independent agent (NY license {BUSINESS.nyLicense}).
      </p>

      <h2>The Westchester County communities I serve</h2>
      <p>
        I work with people in White Plains, Yonkers, New Rochelle, and Mount Vernon, out through Yorktown, Mount Kisco, Peekskill,
        Scarsdale, and Rye — anywhere in the county. Because reviews are done by phone or video, your location never limits the help;
        it just frames the local picture we walk through.
      </p>

      <h2>Keep your doctors — White Plains Hospital, St. John’s, the Montefiore network, and any Medicare provider</h2>
      <p>
        In a county this dense with hospitals, provider freedom is the whole point. With a
        <a href="/services/medicare-supplement">Medicare Supplement (Medigap)</a> plan, you can use White Plains Hospital (part of
        the Montefiore Einstein network), St. John’s Riverside in Yonkers, Montefiore New Rochelle or Mount Vernon, the regional
        Westchester Medical Center in Valhalla — or any specialist in New York City and beyond that accepts Medicare, with no network
        and no referrals. Medicare Advantage plans route you through a network instead, which in a market with this many options is a
        meaningful trade-off. See <a href="/medicare-advantage-vs-medigap">Medicare Advantage vs. Medigap</a> for the full picture.
      </p>

      <h2>The New York advantage, in Westchester County</h2>
      <p>
        New York is one of only two states (with Connecticut) with year-round, guaranteed-issue Medigap and community-rated pricing.
        For Westchester residents — who see relentless Medicare Advantage marketing — that means Medigap is always on the table: you
        can review or switch in any month, with no health questions, and your age and health can’t raise your premium. More on our
        <a href="/new-york-medicare-supplement">New York Medicare Supplement</a> page.
      </p>

      <h2>Where High-Deductible Plan G fits</h2>
      <p>
        Westchester premiums run higher than much of the region, so the lower-premium
        <a href="/services/high-deductible-medicare-supplement">High-Deductible Plan G</a> ({MEDICARE_2026.hdDeductible} deductible
        in {MEDICARE_2026.year}) often deserves a serious look — the same any-provider freedom for a much smaller monthly cost.
        Whether it makes sense depends on your health and budget; we’d run your numbers to find out.
      </p>

      <h2>In a market this loud, a second opinion pays</h2>
      <p>
        Westchester sees more Medicare marketing than anywhere else in the region — the TV spots, the mailers dressed up to look
        official, the celebrity pitches. Much of it pushes Medicare Advantage and its list of extras, and for some people that’s a
        fine fit. But the sheer volume of advertising is exactly why a calm, independent review is worth your time here: someone who
        isn’t tied to one carrier, who’ll show you the real total cost of each path and tell you honestly when Medigap isn’t the
        lower-cost option for you. And because New York’s guaranteed issue means you’re never locked in, there’s no harm in getting a
        clear-eyed comparison — before or after you decide.
      </p>

      <h2>How we meet</h2>
      <p>
        A phone call or Zoom screen-share handles the whole review, so distance from the Hudson Valley is never a factor — and
        you’ll have my direct line afterward, not a queue. <a href="/contact">Request a no-cost review</a> or call {BUSINESS.phone}.
      </p>

      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (<div class="mb-5"><h3 class="text-xl">{f.q}</h3><p>{f.a}</p></div>))}

      <p class="text-sm text-navy-500">
        Nearby: <a href="/service-areas/orange-county">Orange County</a> ·
        <a href="/service-areas/dutchess-county">Dutchess County</a> ·
        <a href="/service-areas">all service areas</a>.
      </p>

      <AuthorByline />

      <div class="not-prose mt-8">
        <Disclaimer variant="tpmo" />
        <p class="text-xs text-navy-500 mt-3 leading-relaxed">
          Hospitals are named as local context only; this site is not affiliated with or endorsed by any hospital or health system.
          Plan availability, benefits, and costs vary and are not guaranteed; {MEDICARE_2026.year} figures change annually. NY
          producer license #: {BUSINESS.nyLicense}.
        </p>
        <p class="text-xs text-navy-500 mt-2 leading-relaxed">
          Source: <a href="https://www.medicare.gov" rel="nofollow noopener" target="_blank">Medicare.gov</a>.
        </p>
      </div>
    </div>
  </article>

  <CTASection headline="Medicare questions in Westchester County? Let’s talk." />
</BaseLayout>
