---
import { BUSINESS, AGENT, IS_PUBLISH, pendingMarker } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  schema?: object;
  noIndex?: boolean;
  seoTitle?: string;
}

const {
  title,
  description = `Clear, no-pressure Medicare guidance from licensed agent Jim Farnham. High-Deductible Medicare Supplement Insurance for New York and Connecticut.`,
  canonical,
  ogImage = '/images/farnham-og.jpg',
  schema,
  noIndex = false,
  seoTitle,
} = Astro.props;

// Titles stay at or under 60 characters: the brand suffix is dropped when it
// would push a page title over the limit.
const baseTitle = seoTitle || title;
const withBrand = `${baseTitle} | ${BUSINESS.shortName}`;
const fullTitle =
  title === 'Home'
    ? `${BUSINESS.name} | Medicare in ${BUSINESS.address.city}, NY`
    : withBrand.length <= 60 ? withBrand : baseTitle;

// Demo (preview) builds are noindex until PUBLISH=1 is set for the launch build.
const robotsNoIndex = noIndex || !IS_PUBLISH;
const pendingMarkers = [
  !BUSINESS.domainConfirmed && 'final domain: farnhamseniorhealth.com is not registered or confirmed',
  !BUSINESS.addressConfirmed && 'office/verification address for Google Business Profile (street address and geo withheld from schema)',
].filter(Boolean).map((l) => pendingMarker(l as string)).join('');

const canonicalUrl = canonical || new URL(Astro.url.pathname, BUSINESS.url).href;

// ---------------------------------------------------------------------
// Default site-wide schema: InsuranceAgency (a LocalBusiness subtype),
// service-area business until the verification address is confirmed.
// Jim is also modeled as a Person (E-E-A-T) and tied in as the agent.
// ---------------------------------------------------------------------
const isHome = Astro.url.pathname === '/';
const WIKI = (p: string) => `https://en.wikipedia.org/wiki/${p}`;
// Places and topics tied to Wikipedia so Google knows exactly which entities are meant.
// (The business's own sameAs stays its own profiles, added when they exist.)
const places = [
  { '@type': 'State', name: 'New York', sameAs: WIKI('New_York_(state)') },
  { '@type': 'State', name: 'Connecticut', sameAs: WIKI('Connecticut') },
  { '@type': 'AdministrativeArea', name: 'Ulster County, New York', sameAs: WIKI('Ulster_County,_New_York') },
  { '@type': 'AdministrativeArea', name: 'Dutchess County, New York', sameAs: WIKI('Dutchess_County,_New_York') },
  { '@type': 'AdministrativeArea', name: 'Orange County, New York', sameAs: WIKI('Orange_County,_New_York') },
  { '@type': 'AdministrativeArea', name: 'Westchester County, New York', sameAs: WIKI('Westchester_County,_New_York') },
  { '@type': 'City', name: 'New Paltz, New York', sameAs: WIKI('New_Paltz,_New_York') },
  { '@type': 'City', name: 'Kingston, New York', sameAs: WIKI('Kingston,_New_York') },
  { '@type': 'City', name: 'Poughkeepsie, New York', sameAs: WIKI('Poughkeepsie,_New_York') },
];
const topics = [
  { '@type': 'Thing', name: 'Medicare', sameAs: WIKI('Medicare_(United_States)') },
  { '@type': 'Thing', name: 'Medigap', sameAs: WIKI('Medigap') },
  { '@type': 'Thing', name: 'Medicare Advantage', sameAs: WIKI('Medicare_Advantage') },
  { '@type': 'Thing', name: 'Medicare Part D', sameAs: WIKI('Medicare_Part_D') },
  { '@type': 'Thing', name: 'Centers for Medicare & Medicaid Services', sameAs: WIKI('Centers_for_Medicare_%26_Medicaid_Services') },
];

const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'InsuranceAgency',
  '@id': `${BUSINESS.url}/#organization`,
  name: BUSINESS.legalName,
  legalName: BUSINESS.legalName,
  url: BUSINESS.url,
  telephone: BUSINESS.phone,
  email: BUSINESS.email,
  image: `${BUSINESS.url}/images/farnham-og.jpg`,
  logo: `${BUSINESS.url}/images/farnham-logo-1200.png`,
  priceRange: 'No-cost consultation',
  // Street address and geo only once Jim supplies a real one (service-area business until then).
  address: {
    '@type': 'PostalAddress',
    ...(BUSINESS.addressConfirmed ? { streetAddress: BUSINESS.address.street } : {}),
    addressLocality: BUSINESS.address.city,
    addressRegion: BUSINESS.address.state,
    ...(BUSINESS.addressConfirmed ? { postalCode: BUSINESS.address.zip } : {}),
    addressCountry: 'US',
  },
  ...(BUSINESS.addressConfirmed
    ? { geo: { '@type': 'GeoCoordinates', latitude: BUSINESS.geo.latitude, longitude: BUSINESS.geo.longitude } }
    : {}),
  areaServed: places,
  founder: { '@id': `${BUSINESS.url}/#agent` },
  employee: { '@id': `${BUSINESS.url}/#agent` },
  knowsAbout: [...topics, ...AGENT.knowsAbout],
  disambiguatingDescription:
    'Independent insurance agency specializing in High-Deductible Medicare Supplement Insurance. Not affiliated with or endorsed by the federal government or the Medicare program.',
};

const agentSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${BUSINESS.url}/#agent`,
  name: AGENT.name,
  jobTitle: AGENT.jobTitle,
  worksFor: { '@id': `${BUSINESS.url}/#organization` },
  alumniOf: AGENT.education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
  knowsAbout: [...AGENT.knowsAbout],
  image: `${BUSINESS.url}${AGENT.photo}`,
  telephone: AGENT.phone,
};

// The full business block (InsuranceAgency) goes on the home page only; every other page carries a
// short Organization record with the same @id. Page-specific schema is merged in via the `schema` prop.
const organizationLite = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${BUSINESS.url}/#organization`,
  name: BUSINESS.legalName,
  url: BUSINESS.url,
  logo: `${BUSINESS.url}/images/farnham-logo-1200.png`,
  telephone: BUSINESS.phone,
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${BUSINESS.url}/#website`,
  url: BUSINESS.url,
  name: BUSINESS.name,
  publisher: { '@id': `${BUSINESS.url}/#organization` },
};
const base = isHome ? [businessSchema, websiteSchema, agentSchema] : [organizationLite, agentSchema];
const schemaGraph = schema ? [...base, schema] : base;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />

  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  {robotsNoIndex && <meta name="robots" content="noindex, nofollow" />}
  <Fragment set:html={pendingMarkers} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`${BUSINESS.url}${ogImage}`} />
  <meta property="og:site_name" content={BUSINESS.name} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${BUSINESS.url}${ogImage}`} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500&family=JetBrains+Mono:wght@400;500&display=swap" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
  <link rel="apple-touch-icon" href="/images/favicon-192.png" />

  <!-- Schema (Organization + Agent + page-specific) -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

  {/* ⚠️ CONFIRM — add GA4 / Tag Manager ID at kickoff (placeholder, intentionally not wired) */}

  <slot name="head" />
</head>
<body id="top" class="min-h-screen flex flex-col antialiased">
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />

  <!-- Scroll animation observer -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add('is-visible');
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.animate-on-scroll').forEach((el) => observer.observe(el));
  </script>
</body>
</html>
