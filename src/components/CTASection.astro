---
import { BUSINESS } from '../data/site';

export interface Props {
  headline?: string;
  text?: string;
}

const {
  headline = 'Let’s Talk — No Pressure, Just Clarity',
  text = 'Get a no-cost, no-obligation Medicare review. Call or text Jim directly, or request a call and he’ll get back to you as soon as possible.',
} = Astro.props;
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-crst-primary via-navy-700 to-crst-secondary"></div>
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 48px 48px;"></div>
  <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-crst-gold/10 blur-3xl"></div>

  <div class="relative container-wide py-16 lg:py-20 text-center">
    <div class="section-divider mx-auto mb-6"></div>
    <h2 class="text-3xl sm:text-4xl font-display text-white mb-4 text-balance">{headline}</h2>
    <p class="text-white/65 font-heading text-lg max-w-2xl mx-auto mb-8 leading-relaxed">{text}</p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      <a href={`tel:${BUSINESS.phoneClean}`} title={`Call ${BUSINESS.name}`} class="btn-accent text-base px-8 py-3.5">
        <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call {BUSINESS.phone}
      </a>
      <a href="/contact" title="Request a call" class="inline-flex items-center justify-center px-7 py-3.5 border-2 border-white/25 text-white font-heading font-semibold text-base rounded-lg transition-all duration-300 hover:bg-white/10 hover:border-white/40">
        Request a Call
      </a>
    </div>
  </div>
</section>
