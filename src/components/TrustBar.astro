---
import { BUSINESS } from '../data/site';

const items = [
  {
    label: `${BUSINESS.stats.yearsInsurance} years in insurance & financial services`,
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>',
  },
  {
    label: `${BUSINESS.stats.yearsMedicare} years focused on Medicare`,
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>',
  },
  {
    label: 'Licensed in New York & Connecticut',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>',
  },
  {
    label: 'Teaches no-cost Medicare 101 classes',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422A12.083 12.083 0 0112 21.5 12.083 12.083 0 015.84 10.578L12 14z"/>',
  },
];
---

<section class="bg-white border-b border-navy-100" aria-label="Why work with Jim Farnham">
  <div class="container-wide py-5">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-4">
      {items.map((item) => (
        <div class="flex items-center gap-2.5">
          <svg class="w-6 h-6 text-crst-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" set:html={item.icon} />
          <span class="text-sm font-heading font-medium text-navy-700 leading-tight">{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
