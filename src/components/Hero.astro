---
import { BUSINESS, AGENT, FORMS, DISCLAIMERS } from '../data/site';
---

<section class="relative bg-crst-primary overflow-hidden">
  <div class="absolute inset-0">
    <img src="/images/senior-couple.png" alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover object-top" loading="eager" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-r from-navy-900/95 via-navy-900/80 to-navy-900/50"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 56px 56px;"></div>
    <div class="absolute top-20 right-0 w-96 h-96 rounded-full bg-crst-accent/10 blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 w-72 h-72 rounded-full bg-crst-gold/8 blur-3xl"></div>
  </div>

  <div class="relative container-wide py-16 lg:py-24">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text -->
      <div>
        <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm rounded-full px-4 py-1.5 mb-6 text-xs font-heading font-medium text-white/80 border border-white/10">
          <span class="w-2 h-2 rounded-full bg-crst-gold animate-pulse"></span>
          {AGENT.credentials} &middot; {BUSINESS.stats.yearsInsurance} years in insurance &amp; financial services
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display text-white leading-[1.08] mb-6">
          A Smarter, More Cost-Effective <span class="text-crst-gold">Approach to Medicare</span>
        </h1>

        <p class="text-lg text-white/75 font-heading leading-relaxed max-w-xl mb-6">
          My approach is to educate first — explain your options clearly and show you how to save money along the way. I specialize in
          <strong class="text-white">High-Deductible Medicare Supplement Insurance</strong> and compare it honestly against
          traditional Medigap, Medicare Advantage, and Part D. If a different path fits better for you, I’ll tell you that too.
        </p>

        <p class="text-base text-white/55 font-heading leading-relaxed max-w-xl mb-8">
          No pressure. No call centers. Just clear, practical guidance from a licensed agent who answers his own phone —
          serving New York and Connecticut.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href={`tel:${BUSINESS.phoneClean}`} class="btn-accent text-base px-7 py-3.5">
            <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call {BUSINESS.phone}
          </a>
          <a href="/services/high-deductible-medicare-supplement" class="inline-flex items-center justify-center px-7 py-3.5 border-2 border-white/20 text-white font-heading font-semibold text-base rounded-lg transition-all duration-300 hover:bg-white/10 hover:border-white/30">
            What is High-Deductible Medigap?
          </a>
        </div>

        <!-- Honest trust signals (no fabricated reviews/ratings) -->
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mt-10 pt-8 border-t border-white/10">
          <div class="flex items-center gap-2 text-xs text-white/55 font-heading">
            <svg class="w-4 h-4 text-crst-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422A12.083 12.083 0 0112 21.5 12.083 12.083 0 015.84 10.578L12 14z"/></svg>
            Taught Medicare 101 at libraries &amp; colleges
          </div>
          <div class="flex items-center gap-2 text-xs text-white/55 font-heading">
            <svg class="w-4 h-4 text-crst-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
            {BUSINESS.stats.yearsMedicare} years focused on Medicare
          </div>
          <div class="flex items-center gap-2 text-xs text-white/55 font-heading">
            <svg class="w-4 h-4 text-crst-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            New York &amp; Connecticut
          </div>
        </div>
      </div>

      <!-- Lead-form card (soft, no-PHI; mirrors /contact submission + consent) -->
      <div class="relative lg:justify-self-end w-full max-w-md mx-auto">
        <div class="bg-white rounded-2xl shadow-2xl border border-navy-100 p-6 sm:p-7">
          <!-- Agent header (⚠️ Client to supply headshot → /public/images/jim-farnham.jpg) -->
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 rounded-full overflow-hidden bg-navy-100 shrink-0 flex items-center justify-center">
              <img src={AGENT.photo} alt={AGENT.fullName} class="w-full h-full object-cover" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
              <span class="hidden w-full h-full items-center justify-center font-display text-crst-primary" style="display:none;">JF</span>
            </div>
            <div>
              <p class="font-display text-crst-primary leading-tight">{AGENT.fullName}</p>
              <p class="text-xs text-navy-500 font-heading">{AGENT.title}</p>
            </div>
          </div>

          <h2 class="text-xl sm:text-2xl font-display text-crst-primary leading-tight mb-1">Get a no-cost, no-obligation Medicare review</h2>
          <p class="text-sm text-navy-500 font-heading mb-5">No cost, no pressure — I’ll personally call you back.</p>

          <form class="space-y-3" method="POST" action={FORMS.webhookUrl || '#'} data-form="lead">
            <div>
              <label for="hero-name" class="sr-only">Name</label>
              <input id="hero-name" name="name" type="text" required autocomplete="name" placeholder="Name" class="w-full rounded-lg border border-navy-200 px-4 py-2.5 text-navy-800 placeholder-navy-400 focus:outline-none focus:ring-2 focus:ring-crst-accent" />
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="hero-phone" class="sr-only">Phone</label>
                <input id="hero-phone" name="phone" type="tel" required autocomplete="tel" placeholder="Phone" class="w-full rounded-lg border border-navy-200 px-4 py-2.5 text-navy-800 placeholder-navy-400 focus:outline-none focus:ring-2 focus:ring-crst-accent" />
              </div>
              <div>
                <label for="hero-zip" class="sr-only">ZIP code</label>
                <input id="hero-zip" name="zip" type="text" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" placeholder="ZIP" class="w-full rounded-lg border border-navy-200 px-4 py-2.5 text-navy-800 placeholder-navy-400 focus:outline-none focus:ring-2 focus:ring-crst-accent" />
              </div>
            </div>
            <div>
              <label for="hero-status" class="sr-only">Your Medicare status</label>
              <select id="hero-status" name="status" required class="w-full rounded-lg border border-navy-200 px-4 py-2.5 text-navy-800 bg-white focus:outline-none focus:ring-2 focus:ring-crst-accent">
                <option value="" disabled selected>I'm…</option>
                <option value="turning-65">Turning 65 soon</option>
                <option value="on-medicare">Already on Medicare</option>
                <option value="exploring">Just exploring my options</option>
              </select>
            </div>

            <label class="flex items-start gap-2.5 text-xs text-navy-500 leading-snug">
              <input type="checkbox" name="consent" required class="mt-0.5 shrink-0" />
              <span>By submitting, I agree to be contacted by a licensed insurance agent by phone, text, email, or mail about Medicare plan options. Consent is not a condition of purchase.</span>
            </label>

            <button type="submit" class="btn-accent w-full justify-center">Request my no-cost review</button>

            <p class="text-[11px] text-navy-400 leading-snug pt-1">{DISCLAIMERS.noPHI}</p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0">
    <svg viewBox="0 0 1440 32" fill="none" class="w-full h-auto"><path d="M0 32h1440V16c-240 10-480 16-720 16S240 26 0 16v16z" fill="white"/></svg>
  </div>
</section>
