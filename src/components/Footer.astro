---
import { BUSINESS, SERVICES, COUNTIES, DISCLAIMERS } from '../data/site';
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-800 text-white/80 relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(to right, white 1px, transparent 1px), linear-gradient(to bottom, white 1px, transparent 1px); background-size: 48px 48px;"></div>

  <div class="relative">
    <!-- Main footer -->
    <div class="container-wide py-14 lg:py-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">

        <!-- Company info -->
        <div>
          <a href="/" title={`${BUSINESS.name} — Home`} class="inline-flex items-center gap-2.5 mb-4">
            <svg class="w-9 h-9 shrink-0" viewBox="0 0 64 64" aria-hidden="true">
              <rect width="64" height="64" rx="14" fill="#ffffff"/>
              <rect x="23" y="18" width="7" height="30" rx="1.8" fill="#1A5F6A"/>
              <rect x="23" y="18" width="21" height="7" rx="1.8" fill="#1A5F6A"/>
              <rect x="23" y="29.5" width="15" height="6.5" rx="1.8" fill="#1A5F6A"/>
            </svg>
            <span class="font-display text-2xl text-white leading-none">
              Farnham<span class="text-crst-gold">.</span>
              <span class="block text-xs font-heading font-medium tracking-widest uppercase text-white/50 mt-1">Senior Health Advisors</span>
            </span>
          </a>
          <p class="text-sm leading-relaxed text-white/60 mb-5">
            Clear, no-pressure Medicare guidance from a licensed agent who answers his own phone. Specializing in High-Deductible Medicare Supplement Insurance for New York and Connecticut.
          </p>
          <div class="space-y-2.5 text-sm">
            <a href={`tel:${BUSINESS.phoneClean}`} title={`Call ${BUSINESS.name}`} class="flex items-center gap-2 hover:text-white transition-colors">
              <svg class="w-4 h-4 text-crst-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              {BUSINESS.phone}
            </a>
            <a href={`mailto:${BUSINESS.email}`} title={`Email ${BUSINESS.name}`} class="flex items-center gap-2 hover:text-white transition-colors break-all">
              <svg class="w-4 h-4 text-crst-gold shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              {BUSINESS.email}
            </a>
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-crst-gold shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>{BUSINESS.address.full}</span>
            </div>
          </div>
        </div>

        <!-- Plans -->
        <div>
          <h2 class="text-white font-heading font-semibold text-sm uppercase tracking-wider mb-4">Medicare Plans</h2>
          <ul class="space-y-2">
            {SERVICES.map((service) => (
              <li>
                <a href={`/services/${service.slug}`} title={service.title} class="text-sm hover:text-white transition-colors">{service.title}</a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Service areas + company -->
        <div>
          <h2 class="text-white font-heading font-semibold text-sm uppercase tracking-wider mb-4">Service Areas</h2>
          <ul class="space-y-2">
            {Object.values(COUNTIES).map((county) => (
              <li><a href={`/service-areas/${county.slug}`} title={county.name} class="text-sm hover:text-white transition-colors">{county.name}</a></li>
            ))}
          </ul>
          <h2 class="text-white font-heading font-semibold text-sm uppercase tracking-wider mb-4 mt-6">Company</h2>
          <ul class="space-y-2">
            <li><a href="/about" class="text-sm hover:text-white transition-colors">About Jim</a></li>
            <li><a href="/medicare-basics" class="text-sm hover:text-white transition-colors">Medicare Basics</a></li>
            <li><a href="/events" class="text-sm hover:text-white transition-colors">Medicare 101 Classes</a></li>
            <li><a href="/faq" class="text-sm hover:text-white transition-colors">FAQ</a></li>
            <li><a href="/contact" class="text-sm hover:text-white transition-colors">Contact</a></li>
          </ul>
        </div>

        <!-- CTA -->
        <div>
          <h2 class="text-white font-heading font-semibold text-sm uppercase tracking-wider mb-4">Get Started</h2>
          <div class="bg-white/5 rounded-lg p-5 border border-white/10">
            <p class="text-white font-heading font-semibold text-base mb-2">No-cost Medicare review</p>
            <p class="text-sm text-white/50 mb-4">No pressure, no obligation — just clear answers about your options.</p>
            <a href={`tel:${BUSINESS.phoneClean}`} title={`Call ${BUSINESS.phone}`} class="btn-accent w-full text-center text-sm py-2.5 mb-2">Call {BUSINESS.phone}</a>
            <a href="/contact" title="Request a call" class="block w-full text-center text-sm py-2.5 text-white/80 border border-white/15 rounded-lg hover:bg-white/10 transition-colors">Request a call</a>
          </div>
        </div>
      </div>

      <!-- Required disclosures (site-wide) -->
      <div class="mt-12 pt-8 border-t border-white/10 space-y-3 text-xs text-white/45 leading-relaxed">
        <p>{DISCLAIMERS.tpmo}</p>
        <p>{DISCLAIMERS.noGovernment}</p>
        <p>{DISCLAIMERS.educational} {DISCLAIMERS.solicitation}</p>
        <p>NY producer license #: {BUSINESS.nyLicense}. {DISCLAIMERS.hdNotForEveryone}</p>
        <p><a href="/disclosures" class="underline hover:text-white/70">Read full disclosures &amp; underwriting information &rarr;</a></p>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10">
      <div class="container-wide flex flex-col sm:flex-row items-center justify-between py-5 gap-3 text-xs text-white/40">
        <p>&copy; {currentYear} {BUSINESS.name}. All rights reserved.</p>
        <div class="flex items-center gap-4">
          <a href="/privacy" class="hover:text-white/70 transition-colors">Privacy Policy</a>
          <span class="text-white/20">|</span>
          <a href="/terms" class="hover:text-white/70 transition-colors">Terms of Use</a>
          <span class="text-white/20">|</span>
          <a href="/disclosures" class="hover:text-white/70 transition-colors">Disclosures</a>
        </div>
      </div>
    </div>
  </div>
</footer>
