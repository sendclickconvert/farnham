---
import { BUSINESS, NAV_ITEMS } from '../data/site';
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-navy-100/60" id="site-header">
  <!-- Top bar -->
  <div class="bg-crst-primary text-white/90 text-xs sm:text-sm font-heading">
    <div class="container-wide flex items-center justify-between py-2">
      <div class="flex items-center gap-4">
        <a href={`tel:${BUSINESS.phoneClean}`} title={`Call ${BUSINESS.name}`} class="flex items-center gap-1.5 hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          <span class="font-semibold">{BUSINESS.phone}</span>
        </a>
        <span class="hidden sm:inline text-white/60">Call or text anytime — I’ll call back ASAP</span>
      </div>
      <div class="hidden sm:flex items-center gap-1.5 text-white/70">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Serving New York & Connecticut
      </div>
    </div>
  </div>

  <!-- Main nav -->
  <div class="container-wide">
    <nav class="flex items-center justify-between h-16 lg:h-20" aria-label="Primary navigation">
      <!-- Logo (⚠️ client to supply logo; falls back to wordmark) -->
      <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label={`${BUSINESS.name} — Home`} title={`${BUSINESS.name} — Home`}>
        <svg class="w-9 h-9 lg:w-10 lg:h-10 shrink-0" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" fill="#1E3A5F"/>
          <rect x="23" y="18" width="7" height="30" rx="1.8" fill="#C8A44E"/>
          <rect x="23" y="18" width="21" height="7" rx="1.8" fill="#C8A44E"/>
          <rect x="23" y="29.5" width="15" height="6.5" rx="1.8" fill="#C8A44E"/>
        </svg>
        <span class="font-display text-xl lg:text-2xl text-crst-primary leading-none">
          Farnham<span class="text-crst-gold">.</span>
          <span class="block text-[0.6rem] lg:text-xs font-heading font-medium tracking-widest uppercase text-navy-500 mt-0.5">Senior Health Advisors</span>
        </span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden lg:flex items-center gap-1">
        {NAV_ITEMS.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              title={item.label}
              class="flex items-center gap-1 px-3 py-2 text-[0.95rem] font-heading font-medium text-navy-700 rounded-md hover:text-crst-primary hover:bg-navy-50 transition-colors"
            >
              {item.label}
              {item.children && (
                <svg class="w-3.5 h-3.5 opacity-50 group-hover:opacity-80 transition-all group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              )}
            </a>
            {item.children && (
              <div class="absolute top-full left-0 pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
                <div class="bg-white rounded-xl shadow-xl shadow-navy-900/10 border border-navy-100 py-2 min-w-[280px]">
                  {item.children.map((child) => (
                    <a href={child.href} title={child.label} class="block px-4 py-2.5 text-sm font-heading text-navy-700 hover:text-crst-primary hover:bg-navy-50 transition-colors">
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- CTA + mobile toggle -->
      <div class="flex items-center gap-3">
        <a href={`tel:${BUSINESS.phoneClean}`} class="hidden sm:inline-flex btn-accent text-sm px-5 py-2.5" title={`Call ${BUSINESS.phone}`}>
          <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
          Call Now
        </a>
        <button type="button" class="lg:hidden p-2 rounded-md text-navy-600 hover:bg-navy-50 transition-colors" aria-label="Open menu" id="mobile-menu-toggle">
          <svg class="w-6 h-6" id="menu-icon-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
          <svg class="w-6 h-6 hidden" id="menu-icon-close" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile menu -->
  <div class="hidden lg:hidden border-t border-navy-100 max-h-[80vh] overflow-y-auto" id="mobile-menu">
    <div class="container-wide py-4 space-y-1">
      {NAV_ITEMS.map((item) => (
        <div>
          {item.children ? (
            <button type="button" class="mobile-submenu-toggle flex items-center justify-between w-full px-3 py-3 text-base font-heading font-medium text-navy-700 rounded-md hover:bg-navy-50 transition-colors">
              {item.label}
              <svg class="w-4 h-4 opacity-50 transition-transform duration-200 submenu-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </button>
          ) : (
            <a href={item.href} title={item.label} class="block px-3 py-3 text-base font-heading font-medium text-navy-700 rounded-md hover:bg-navy-50 transition-colors">
              {item.label}
            </a>
          )}
          {item.children && (
            <div class="hidden ml-4 border-l-2 border-navy-100 pl-3 mt-1 space-y-0.5 mobile-submenu">
              {item.children.map((child) => (
                <a href={child.href} title={child.label} class="block px-3 py-2 text-sm text-navy-600 rounded-md hover:bg-navy-50 hover:text-crst-primary transition-colors">
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
      <div class="pt-3 border-t border-navy-100">
        <a href={`tel:${BUSINESS.phoneClean}`} title={`Call ${BUSINESS.phone}`} class="btn-accent w-full text-center text-base py-3">
          Call {BUSINESS.phone}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
  });

  document.querySelectorAll('.mobile-submenu-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const submenu = btn.parentElement?.querySelector('.mobile-submenu');
      const arrow = btn.querySelector('.submenu-arrow');
      submenu?.classList.toggle('hidden');
      arrow?.classList.toggle('rotate-180');
    });
  });
</script>
